/// hechos.tb_fact_tickets_udo_gold: un ticket UDO (ultima version). Sustituye a Data_Tickets_Abiertos + Data_Tickets_Resueltos (BASE) del PBIX original: Abiertos = fecha_creacion, Resueltos = es_resuelto=1 por fecha_resolucion. Sin cancelados (como el original). Las marcas K_* son solo etiquetas de dt_/ta_/rn1_/udo_ (aplica/cumple vienen de gold).
table Data_Tickets
	lineageTag: 4e18b337-9df6-5d36-b210-91be02999161

	column K_DETECCION_TEMPRANA = IF(Data_Tickets[dt_aplica] = 1, IF(Data_Tickets[dt_cumple] = 1, "Cumple SLA Detección Temprana", "No Cumple SLA Detección Temprana"), BLANK())
		dataType: string
		lineageTag: e5d29d61-c062-507a-9107-76ccca3de78f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column K_TIEMPO_MEDIO_ATENCION = IF(Data_Tickets[ta_aplica] = 1, IF(Data_Tickets[ta_cumple] = 1, "Cumple SLA Tiempo Atención", "No Cumple SLA Tiempo Atención"), BLANK())
		dataType: string
		lineageTag: 175cc8f9-08b1-55ea-9c06-d2979df0806f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column K_TICKETS_RESTAURADOS = IF(Data_Tickets[rn1_aplica] = 1 && NOT ISBLANK(Data_Tickets[rn1_cumple]), IF(Data_Tickets[rn1_cumple] = 1, "Cumple Restaurados N1", "No Cumple Restaurados N1"), BLANK())
		dataType: string
		lineageTag: f6a04160-61d5-52fa-9fef-0b25e5f6d1ec
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column K_UDO = IF(Data_Tickets[udo_aplica] = 1, IF(Data_Tickets[udo_cumple] = 1, "Cumple Actualización UDOs", "No Cumple Actualización UDOs"), BLANK())
		dataType: string
		lineageTag: 688601bb-e9fe-50ed-857d-a1d3ac0bb59b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic


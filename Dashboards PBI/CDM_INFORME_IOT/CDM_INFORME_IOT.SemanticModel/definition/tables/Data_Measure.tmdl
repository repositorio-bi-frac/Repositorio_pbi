	/// Tickets resueltos notificables (hechos.tb_fact_tickets_udo_gold.notificable, sql 022).
	measure #Mayor_Notificable =
			VAR DATO = CALCULATE([#_Resueltos], Data_Tickets[notificable] = "Yes")

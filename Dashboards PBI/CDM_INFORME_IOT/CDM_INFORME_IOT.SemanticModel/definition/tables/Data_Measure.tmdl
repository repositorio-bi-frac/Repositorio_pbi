	/// Hay tickets abiertos con informacion UDO sin actualizar (>= 24 h): marca de color del KPI.
	measure '## Marca_Color_UDO' =
			VAR VAL = CALCULATE(COUNTROWS(Data_Tickets), Data_Tickets[udo_aplica] = 1, Data_Tickets[udo_cumple] = 0)
			VAR COLOR = IF(VAL <> 0, 1, 0)
			RETURN
			COLOR
		formatString: 0
		displayFolder: KPI
		lineageTag: a5078191-09aa-59de-b83b-467bc6b19ff9

	measure #Llamadas_Recibidas =
			VAR DATO = SUM(Data_Llamadas[recibida])

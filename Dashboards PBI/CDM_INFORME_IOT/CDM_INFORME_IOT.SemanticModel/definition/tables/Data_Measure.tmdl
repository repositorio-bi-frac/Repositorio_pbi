/// Medidas del informe. Una medida por indicador; todo el calculo pesado (aplica/cumple, N1/Resto, laborable...) viene ya resuelto de gold.
table Data_Measure
	lineageTag: 7480bcc2-66ee-5a12-98dd-5a193cc4f441

	/// Tickets resueltos (BASE = Resueltos del original): es_resuelto = 1, fechados por fecha/hora de resolucion.
	measure #_Resueltos =
			CALCULATE(COUNTROWS(Data_Tickets), Data_Tickets[es_resuelto] = 1,
			USERELATIONSHIP(Data_Tickets[fecha_resolucion], Data_Calendario[FECHA]),
			USERELATIONSHIP(Data_Tickets[hora_resolucion], Data_Horario[CLASIFICACION]))
		formatString: 0
		isHidden
		displayFolder: Base
		lineageTag: b9ac584d-b06d-58f3-8820-be2eaddb82ff

	/// Tickets (BASE = Abiertos del original): fechados por fecha/hora de creacion.
	measure #_Abiertos = COUNTROWS(Data_Tickets)
		formatString: 0
		isHidden
		displayFolder: Base
		lineageTag: c34ae8e5-982c-5c96-8fe0-c0fc87bfa80b

	measure #Volumetria_Tickets_Abiertos =
			VAR DATO = [#_Abiertos]
			RETURN
			IF(ISBLANK(DATO), 0, DATO)
		formatString: #,0
		displayFolder: Tickets
		lineageTag: da38b92f-83bb-5fbb-baec-8aeaf36ed40e

	measure #Volumetria_Tickets_Resueltos =
			VAR DATO = [#_Resueltos]
			RETURN
			IF(ISBLANK(DATO), 0, DATO)
		formatString: #,0
		displayFolder: Tickets
		lineageTag: 6cd169ae-255a-5a34-8733-279de478164c

	measure #Volumetria_Tickets_Gestionados_N1 =
			VAR DATO = CALCULATE([#_Resueltos], Data_Resolutor[GRUPO_CERRADOS] = "N1")
			RETURN
			IF(ISBLANK(DATO), 0, DATO)
		formatString: 0
		displayFolder: Tickets
		lineageTag: b39443f3-0c4d-510b-a1df-3225bffc79ea

	measure #Volumetria_SolvedClosed =
			VAR PERIODO = MAX(Data_Calendario[PERIODO])
			VAR DATO = CALCULATE([#_Abiertos], Data_Tickets[periodo_creacion] = PERIODO, Data_Status[STATUS] = "Solved" || Data_Status[STATUS] = "Closed")
			RETURN
			IF(ISBLANK(DATO), 0, DATO)
		formatString: 0
		displayFolder: Tickets
		lineageTag: 7e36d3cf-349e-5149-aa2e-705a357d6a4f

	measure #Volumetria_Restored =
			VAR PERIODO = MAX(Data_Calendario[PERIODO])

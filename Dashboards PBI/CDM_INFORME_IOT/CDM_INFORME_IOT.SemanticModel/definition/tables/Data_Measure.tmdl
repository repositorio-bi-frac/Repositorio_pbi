		displayFolder: Llamadas
		lineageTag: f06e81ca-c381-5988-b5da-2abe2d6c848a

	measure #NDA = IFERROR(([#Llamadas_Atendidas] + [#Llamadas_Escapadas]) / [#Llamadas_Recibidas], "-")

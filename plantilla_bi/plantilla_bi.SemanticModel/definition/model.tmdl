model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Tabla_Combinada","tb_dim_status","tb_dim_fte","Calendario","Actualizacion","Medidas"]

annotation PBI_ProTooling = ["DevMode"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table tb_dim_status
ref table Tabla_Combinada
ref table Calendario
ref table Actualizacion
ref table Medidas
ref table tb_dim_fte

ref cultureInfo en-US


table Medidas
	lineageTag: medidas-table

	measure Abiertos = DISTINCTCOUNT(Tabla_Combinada[incident_number])
		formatString: 0
		displayFolder: Calculos
		lineageTag: a29c0bfb-cf7c-4eb6-adba-6c3df64d61c0

	measure Aperturados = [Abiertos]
		formatString: 0
		displayFolder: Calculos
		lineageTag: a01daece-5ba8-44d4-ba09-15f7b34b0be8

	measure Cerrados = CALCULATE([Abiertos], USERELATIONSHIP(Calendario[Date], Tabla_Combinada[fecha_cierre_dia]))
		formatString: 0
		displayFolder: Calculos
		lineageTag: 3fa54851-c1cf-4c72-ac5f-4a86c9661ddb

	measure Balance = [Abiertos] - [Cerrados]
		formatString: 0
		displayFolder: Calculos
		lineageTag: 6f83b55d-1016-49b2-8219-a37a2a325f95

	measure RT_Balance =
			CALCULATE(
			    [Balance],
			    FILTER(
			        ALL(Calendario),
			        Calendario[Date] <= MAX(Calendario[Date]) && NOT(ISBLANK(Calendario[Date]))
			    )
			)
		formatString: 0
		displayFolder: Calculos
		lineageTag: 50e2e38d-ed30-4a53-8da4-2692b1dbdc0a


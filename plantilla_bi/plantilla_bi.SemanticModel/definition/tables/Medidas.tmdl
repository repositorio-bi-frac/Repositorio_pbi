			-- sin relleno detras. No volver a ponerle fondo pensando que no contrasta.
			VAR __Icono =
			    "<svg width='15' height='15' viewBox='0 0 24 24' fill='none' style='flex-shrink:0;'>"
			        & "<path d='M4 6h16M7.5 12h9M10.5 18h3' stroke='#FFFFFF' stroke-width='2.2'"
			        & " stroke-linecap='round'></path></svg>"
			
			VAR __Contenedor =
			    [DS_Fuente]
			        & "height:100%;width:100%;box-sizing:border-box;display:flex;flex-direction:column;"
			        & "justify-content:flex-end;padding:0 2px 2px 4px;background:transparent;"
			
			RETURN
			    "<div style='" & __Contenedor & "'>"
			        & "<div style='display:flex;flex-direction:row;align-items:center;gap:7px;'>"
			            & __Icono
			            & "<div style='font-size:14px;font-weight:700;color:#FFFFFF;"
			            & "letter-spacing:1.1px;white-space:nowrap;'>FILTROS</div>"
			        & "</div>"
			        & "<div style='height:2px;width:100%;margin-top:5px;border-radius:1px;"
			        & "background:rgba(255,255,255,0.35);'></div>"
			    & "</div>"
		displayFolder: Diseno HTML\Titulos
		lineageTag: f6a7b8c9-0006-4d77-9f77-700000000006


	/// ================================================================
	/// MODELO NUEVO: COLUMNAS AGRUPADAS CON SERIES POR MEDIDA
	/// Es el modelo que faltaba: las series NO salen de una dimension, son N
	/// medidas distintas puestas lado a lado sobre el mismo eje de periodo.
	/// El apilado (HTML_Volumetria_Apilado) parte UNA medida por una dimension;
	/// este compara VARIAS medidas entre si.
	///
	/// Para reutilizarlo: cambiar las dos medidas de @S1 y @S2, sus nombres en
	/// __Nombre1/__Nombre2 y el titulo. Para una tercera serie se duplica el
	/// bloque de la barra (misma forma que el motor de lineas, que lleva 3).
	///
	/// Alturas en PX, nunca en %: height:100% es inerte en el visual HTML Content
	/// y un porcentaje contra un alto indefinido colapsa la barra a cero.
	/// ================================================================
	measure HTML_Barras_Agrupadas =
			VAR __Nombre1 = "Aperturados"
			VAR __Nombre2 = "Cerrados"
			VAR __Color1 = PATHITEM([DS_Paleta], 2)
			VAR __Color2 = PATHITEM([DS_Paleta], 4)

			/* ---------- 1. periodos visibles, con las dos medidas ---------- */
			VAR __Categorias =
			    FILTER(
			        ADDCOLUMNS(
			            SUMMARIZE(
			                Tabla_Combinada,
			                Calendario[Anio],
			                Calendario[Mes]
			            ),
			            "@Orden", Calendario[Anio] * 100 + Calendario[Mes],
			            "@Etiqueta",
			                SWITCH(
			                    Calendario[Mes],
			                    1, "ene", 2, "feb", 3, "mar", 4, "abr",
			                    5, "may", 6, "jun", 7, "jul", 8, "ago",
			                    9, "sep", 10, "oct", 11, "nov", 12, "dic",
			                    ""
			                )
			                    & " "
			                    & RIGHT(FORMAT(Calendario[Anio], "0000"), 2),
			            "@S1", CALCULATE([Aperturados]),
			            "@S2", CALCULATE([Cerrados])
			        ),
			        COALESCE([@S1], 0) > 0 || COALESCE([@S2], 0) > 0
			    )
			VAR __CantidadCategorias = COALESCE(COUNTROWS(__Categorias), 0)
			VAR __Maximo =
			    MAXX(
			        __Categorias,
			        MAX(COALESCE([@S1], 0), COALESCE([@S2], 0))
			    )
			VAR __SinDatos =
			    __CantidadCategorias = 0 || ISBLANK(__Maximo) || __Maximo = 0
			/* Cuantos periodos caben de verdad. El ancho va cableado porque en esta
			   plantilla las medidas llevan su geometria en el DAX; si se cambia el
			   ancho del visual hay que cambiarlo aqui. En un informe con tabla
			   desconectada de anchos se reemplaza por SELECTEDVALUE. */
			VAR __AnchoContenedor = 400
			VAR __AnchoMinPeriodo = 63
			VAR __AnchoUtil = MAX(120, __AnchoContenedor - 22)
			VAR __Caben = MAX(1, INT(DIVIDE(__AnchoUtil, __AnchoMinPeriodo, 0)))
			VAR __Entran = __CantidadCategorias <= __Caben
			/* Con scroll horizontal la barra de desplazamiento se come los ultimos
			   ~16 px de la caja y tapa la fila de etiquetas del eje X. Se le reserva
			   el espacio, y la caja lleva altura explicita: con alto automatico el
			   scrollbar recorta el contenido en vez de agrandar la caja. */
			VAR __EspacioScroll = IF(__Entran, 0, 16)
			VAR __AltoPlot = 150 - __EspacioScroll
			VAR __AltoMaxBarra = __AltoPlot - 14
			VAR __AltoCaja = __AltoPlot + 25 + __EspacioScroll

			/* ---------- 2. una columna por periodo, con las dos barras ---------- */
			VAR __ColumnasHTML =
			    CONCATENATEX(
			        __Categorias,
			        VAR __Etq = [@Etiqueta]
			        VAR __V1 = COALESCE([@S1], 0)
			        VAR __V2 = COALESCE([@S2], 0)
			        VAR __H1 = MAX(2, DIVIDE(__V1, MAX(__Maximo, 1), 0) * __AltoMaxBarra)
			        VAR __H2 = MAX(2, DIVIDE(__V2, MAX(__Maximo, 1), 0) * __AltoMaxBarra)
			        VAR __Barra1 =
			            "<div title='" & __Etq & " | " & __Nombre1 & ": " & FORMAT(__V1, "#,0") & "'"
			                & " style='position:relative;flex:1 1 0;max-width:26px;min-width:5px;"
			                & "height:" & FORMAT(__H1, "0", "en-US") & "px;"
			                & "background:" & __Color1 & ";border-radius:3px 3px 0 0;"
			                & "box-sizing:border-box;'>"
			                & "<div style='position:absolute;left:50%;bottom:100%;"
			                & "transform:translateX(-50%);margin-bottom:2px;font-size:9px;"
			                & "font-weight:600;color:" & __Color1 & ";white-space:nowrap;'>"
			                & FORMAT(__V1, "#,0")
			                & "</div>"
			            & "</div>"
			        VAR __Barra2 =
			            "<div title='" & __Etq & " | " & __Nombre2 & ": " & FORMAT(__V2, "#,0") & "'"
			                & " style='position:relative;flex:1 1 0;max-width:26px;min-width:5px;"
			                & "height:" & FORMAT(__H2, "0", "en-US") & "px;"
			                & "background:" & __Color2 & ";border-radius:3px 3px 0 0;"
			                & "box-sizing:border-box;'>"
			                & "<div style='position:absolute;left:50%;bottom:100%;"
			                & "transform:translateX(-50%);margin-bottom:2px;font-size:9px;"
			                & "font-weight:600;color:" & __Color2 & ";white-space:nowrap;'>"
			                & FORMAT(__V2, "#,0")
			                & "</div>"
			            & "</div>"
			        RETURN
			            "<div style='min-width:0;display:flex;flex-direction:column;"
			                & "align-items:center;box-sizing:border-box;padding:0 4px;'>"
			                & "<div style='width:100%;height:" & FORMAT(__AltoPlot, "0") & "px;"
			                & "flex:0 0 " & FORMAT(__AltoPlot, "0") & "px;display:flex;"
			                & "flex-direction:row;align-items:flex-end;justify-content:center;"
			                & "gap:3px;border-bottom:1px solid " & [DS_Color_Divisor] & ";"
			                & "box-sizing:border-box;'>"
			                    & __Barra1
			                    & __Barra2
			                & "</div>"
			                & "<div style='height:25px;padding-top:6px;box-sizing:border-box;"
			                & "font-size:10px;font-weight:500;color:"
			                & [DS_Color_TextoSecundario]
			                & ";white-space:nowrap;text-align:center;'>"
			                & __Etq
			                & "</div>"
			            & "</div>",
			        "",
			        [@Orden],
			        ASC
			    )

			/* ---------- 3. leyenda ---------- */
			VAR __LeyendaHTML =
			    "<span style='display:inline-flex;align-items:center;gap:6px;margin-right:16px;"
			        & "font-size:11px;color:" & [DS_Color_TextoSecundario] & ";white-space:nowrap;'>"
			        & "<span style='width:9px;height:9px;border-radius:3px;background:"
			        & __Color1 & ";display:inline-block;'></span>"
			        & __Nombre1
			    & "</span>"
			    & "<span style='display:inline-flex;align-items:center;gap:6px;"
			        & "font-size:11px;color:" & [DS_Color_TextoSecundario] & ";white-space:nowrap;'>"
			        & "<span style='width:9px;height:9px;border-radius:3px;background:"
			        & __Color2 & ";display:inline-block;'></span>"
			        & __Nombre2
			    & "</span>"

			/* ---------- 4. ancho: si no entran, scroll y avisarlo en el titulo ---------- */
			VAR __AnchoInterno =
			    IF(
			        __Entran,
			        "100%",
			        FORMAT(__CantidadCategorias * (__AnchoMinPeriodo + 13), "0") & "px"
			    )
			VAR __ColumnasGrid =
			    "repeat(" & FORMAT(__CantidadCategorias, "0") & ", minmax("
			        & IF(__Entran, "0", FORMAT(__AnchoMinPeriodo, "0") & "px") & ", 1fr))"

			RETURN
			    "<div style='height:100%;max-height:100%;" & [DS_Contenedor_Estilo] & "'>"
			        & "<div style='" & [DS_Titulo_Estilo] & "'>"
			            & __Nombre1 & " vs " & __Nombre2
			            & IF(
			                NOT __Entran,
			                " - " & FORMAT(__CantidadCategorias, "#,0")
			                    & " periodos (desplazar para ver todos)",
			                ""
			            )
			        & "</div>"
			        & IF(
			            __SinDatos,
			            "<div style='" & [DS_SinDatos_Estilo] & "'>" & [DS_SinDatos_Mensaje] & "</div>",
			            "<div style='width:100%;height:" & FORMAT(__AltoCaja, "0") & "px;"
			                & "overflow-x:auto;overflow-y:hidden;box-sizing:border-box;'>"
			                & "<div style='width:" & __AnchoInterno & ";display:grid;"
			                & "grid-template-columns:" & __ColumnasGrid & ";"
			                & "align-items:end;column-gap:4px;box-sizing:border-box;'>"
			                    & __ColumnasHTML
			                & "</div>"
			            & "</div>"
			            & "<div style='display:flex;align-items:center;flex-wrap:wrap;"
			                & "flex:0 0 26px;height:26px;padding-top:2px;border-top:1px solid "
			                & [DS_Color_Divisor] & ";box-sizing:border-box;overflow:hidden;'>"
			                & __LeyendaHTML
			            & "</div>"
			        )
			    & "</div>"
		displayFolder: Diseno HTML\Graficos
		lineageTag: b1a70000-9004-4000-9000-000000000001

	column Column1
		lineageTag: ae78e056-9e0e-4ce8-9fa5-33a23c78a09b
		isNameInferred
		sourceColumn: [Column1]

	partition Medidas = calculated
		mode: import
		source = ROW("Column1", 1)

	annotation PBI_ResultType = Table


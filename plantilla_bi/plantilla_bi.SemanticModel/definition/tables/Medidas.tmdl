	measure 'Ultima Actualizacion' = MAX(Actualizacion[UltimaActualizacion])
		formatString: General Date
		displayFolder: Calculos
		lineageTag: 8d6f4a2a-1c3f-4b5e-9a7d-2e5f8c1b9a3e

	measure HTML_Volumetria_Apilado =
			
			/* ============================================================
			   1. Meses visibles segun los filtros activos
			   ============================================================ */
			VAR __Categorias =
			    FILTER(
			        ADDCOLUMNS(
			            SUMMARIZE(
			                Tabla_Combinada,
			                Calendario[Anio],
			                Calendario[Mes]
			            ),
			            "@Orden",
			                Calendario[Anio] * 100 + Calendario[Mes],
			            "@Etiqueta",
			                SWITCH(
			                    Calendario[Mes],
			                    1, "ene",
			                    2, "feb",
			                    3, "mar",
			                    4, "abr",
			                    5, "may",
			                    6, "jun",
			                    7, "jul",
			                    8, "ago",
			                    9, "sep",
			                    10, "oct",
			                    11, "nov",
			                    12, "dic",
			                    ""
			                )
			                & " "
			                & RIGHT(FORMAT(Calendario[Anio], "0000"), 2),
			            "@Total",
			                CALCULATE(DISTINCTCOUNT(Tabla_Combinada[incident_number]))
			        ),
			        [@Total] > 0
			    )
			
			VAR __CantidadCategorias =
			    COUNTROWS(__Categorias)
			
			VAR __Maximo =
			    MAXX(__Categorias, [@Total])
			
			/* ============================================================
			   2. Grupos visibles y colores (tokens DS_Color_Grupo_Oscuro / DS_Orden_Grupo)
			   ============================================================ */
			VAR __Grupos =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES(tb_dim_fte[grupo_soporte]),
			
			            "@GrupoTxt",
			                VAR __Grupo = tb_dim_fte[grupo_soporte]
			                RETURN
			                    IF(ISBLANK(__Grupo) || __Grupo = "", "(Sin asignar)", __Grupo),
			
			            "@OrdenGrupo", [DS_Orden_Grupo],
			
			            "@Color", [DS_Color_Grupo_Oscuro],
			
			            "@ValorGrupo",
			                CALCULATE(DISTINCTCOUNT(Tabla_Combinada[incident_number]))
			        ),
			        [@ValorGrupo] > 0
			    )
			
			/* ============================================================
			   3. Columnas apiladas
			   ============================================================ */
			VAR __ColumnasHTML =
			    CONCATENATEX(
			        __Categorias,
			
			        VAR __AnioActual = Calendario[Anio]
			        VAR __MesActual = Calendario[Mes]
			        VAR __TotalActual = [@Total]
			        VAR __EtiquetaActual = [@Etiqueta]
			
			        VAR __AlturaBarraPx = MAX(4, DIVIDE(__TotalActual, MAX(__Maximo, 1), 0) * 90)
			
			        VAR __SegmentosHTML =
			            CONCATENATEX(
			                __Grupos,
			
			                VAR __GrupoActual = tb_dim_fte[grupo_soporte]
			                VAR __GrupoTexto = [@GrupoTxt]
			                VAR __ColorActual = [@Color]
			
			                VAR __ValorActual =
			                    CALCULATE(
			                        DISTINCTCOUNT(Tabla_Combinada[incident_number]),
			                        KEEPFILTERS(TREATAS({ __AnioActual }, Calendario[Anio])),
			                        KEEPFILTERS(TREATAS({ __MesActual }, Calendario[Mes])),
			                        KEEPFILTERS(TREATAS({ __GrupoActual }, tb_dim_fte[grupo_soporte]))
			                    )
			
			                VAR __SegmentoPct = MAX(0, DIVIDE(__ValorActual, MAX(__TotalActual, 1), 0) * 100)
			
			                RETURN
			                    IF(
			                        __ValorActual > 0,
			
			                        "<div"
			                            & " title='"
			                            & __EtiquetaActual
			                            & " | "
			                            & __GrupoTexto
			                            & ": "
			                            & FORMAT(__ValorActual, "#,0")
			                            & "'"
			                            & " style='"
			                            & "width:100%;"
				                            & "flex:" & FORMAT(__ValorActual, "0", "en-US") & " 1 0%;"
				                            & "min-height:1px;"
			                            & "background:"
			                            & __ColorActual
			                            & ";"
			                            & "box-sizing:border-box;"
			                            & "'>"
			                            & "</div>",
			
			                        ""
			                    ),
			
			                "",
			                [@OrdenGrupo],
			                DESC
			            )
			
			        RETURN
			            "<div style='"
			                & "min-width:0;"
			                & "height:100%;"
			                & "display:flex;"
			                & "flex-direction:column;"
			                & "align-items:center;"
			                & "box-sizing:border-box;"
			                & "padding:0 7px;"
			                & "'>"
			
			                & "<div style='"
			                    & "position:relative;"
			                    & "width:100%;"
			                    & "flex:1 1 auto;min-height:0;"
			                    & "display:flex;"
			                    & "align-items:flex-end;"
			                    & "justify-content:center;"
			                    & "border-bottom:1px solid #DCE6F5;"
			                    & "box-sizing:border-box;"
			                    & "'>"
			
			                    & "<div style='"
			                        & "position:absolute;"
			                        & "bottom:calc(" & FORMAT(__AlturaBarraPx, "0", "en-US") & "px + 6px);"
			                        & "left:50%;"
			                        & "transform:translateX(-50%);"
			                        & "font-size:10px;"
			                        & "font-weight:600;"
			                        & "color:#3D4D68;"
			                        & "white-space:nowrap;"
			                        & "'>"
			                        & FORMAT(__TotalActual, "#,0")
			                    & "</div>"
			
			                    & "<div style='"
			                        & "width:86%;"
			                        & "max-width:64px;"
			                        & "min-width:18px;"
			                        & "height:" & FORMAT(__AlturaBarraPx, "0", "en-US") & "px;" & "flex:0 0 " & FORMAT(__AlturaBarraPx, "0", "en-US") & "px;"
			                        & "display:flex;"
			                        & "flex-direction:column;"
			                        & "justify-content:flex-end;"
			                        & "overflow:hidden;"
			                        & "border-radius:4px 4px 0 0;"
			                        & "box-shadow:0 1px 2px rgba(15,45,104,0.12);"
			                        & "box-sizing:border-box;"
			                        & "'>"
			                        & __SegmentosHTML
			                    & "</div>"
			
			                & "</div>"
			
			                & "<div style='"
			                    & "height:25px;"
			                    & "padding-top:6px;"
			                    & "box-sizing:border-box;"
			                    & "font-size:10px;"
			                    & "font-weight:500;"
			                    & "color:#62708A;"
			                    & "white-space:nowrap;"
			                    & "text-align:center;"
			                    & "'>"
			                    & __EtiquetaActual
			                & "</div>"
			
			            & "</div>",
			
			        "",
			        [@Orden],
			        ASC
			    )
			
			/* ============================================================
			   4. Leyenda
			   ============================================================ */
			VAR __LeyendaHTML =
			    CONCATENATEX(
			        __Grupos,
			
			        "<span style='"
			            & "display:inline-flex;"
			            & "align-items:center;"
			            & "gap:6px;"
			            & "margin-right:16px;"
			            & "margin-bottom:3px;"
			            & "font-size:11px;"
			            & "color:#53627C;"
			            & "white-space:nowrap;"
			            & "'>"
			
			            & "<span style='"
			                & "width:9px;"
			                & "height:9px;"
			                & "border-radius:3px;"
			                & "background:"
			                & [@Color]
			                & ";"
			                & "display:inline-block;"
			                & "box-shadow:0 1px 2px rgba(0,0,0,0.10);"
			                & "'>"
			            & "</span>"
			
			            & [@GrupoTxt]
			
			        & "</span>",
			
			        "",
			        [@OrdenGrupo],
			        ASC
			    )
			
			VAR __SinDatos =
			    __CantidadCategorias = 0
			        || ISBLANK(__Maximo)
			        || __Maximo = 0
			
			VAR __AnchoInterno =
			    IF(
			        __CantidadCategorias <= 12,
			        "100%",
			        FORMAT(__CantidadCategorias * 68, "0") & "px"
			    )
			
			VAR __ColumnasGrid =
			    "repeat(" & FORMAT(__CantidadCategorias, "0") & ", minmax(" & IF(__CantidadCategorias <= 12, "0", "52px") & ", 1fr))"
			
			/* ============================================================
			   5. Resultado final (usa tokens DS_Contenedor_Estilo / DS_Titulo_Estilo / DS_SinDatos_*)
			   ============================================================ */
			RETURN
			    "<div style='"
			        & "height:100%;"
			        & "max-height:100%;"
			        & [DS_Contenedor_Estilo]
			        & "'>"
			
			        & "<div style='" & [DS_Titulo_Estilo] & "'>"
			            & "Volumetria"
			            & IF(
			                __CantidadCategorias > 12,
			                " - " & FORMAT(__CantidadCategorias, "#,0") & " meses (desplazar para ver todos)",
			                ""
			            )
			        & "</div>"
			
			        & IF(
			            __SinDatos,
			
			            "<div style='" & [DS_SinDatos_Estilo] & "'>"
			                & [DS_SinDatos_Mensaje]
			            & "</div>",
			
			            "<div style='"
			                & "width:100%;"
			                & "flex:1 1 auto;"
			                & "min-height:0;"
			                & "overflow-x:"
			                & "auto"
			                & ";"
			                & "overflow-y:hidden;"
			                & "box-sizing:border-box;"
			                & "'>"
			
			                & "<div style='"
			                    & "width:"
			                    & __AnchoInterno
			                    & ";"
			                    & "height:100%;"
			                    & "display:grid;"
			                    & "grid-template-columns:"
			                    & __ColumnasGrid
			                    & ";"
			                    & "align-items:end;"
			                    & "column-gap:4px;"
			                    & "box-sizing:border-box;"
			                    & "'>"
			
			                    & __ColumnasHTML
			
			                & "</div>"
			            & "</div>"
			
			            & "<div style='"
			                & "display:flex;"
			                & "align-items:center;"
			                & "flex-wrap:wrap;"
			                & "height:20px;"
			                & "min-height:20px;"
			                & "padding-top:2px;"
			                & "border-top:1px solid #EEF3FA;"
			                & "box-sizing:border-box;"
			                & "overflow:hidden;"
			                & "flex:0 0 26px;"
			                & "'>"
			                & __LeyendaHTML
			            & "</div>"
			        )
			
			    & "</div>"
		displayFolder: Diseno HTML\Graficos
		lineageTag: b6f4e7c1-9a2d-4e3f-8c1b-7d5a9e2f4b6c

	measure HTML_Volumetria_MatrizSoporte =
			
			
			/* ============================================================
			   1. Meses visibles segun los filtros activos (columnas)
			   ============================================================ */
			VAR __Meses =
			    FILTER(
			        ADDCOLUMNS(
			            SUMMARIZE(
			                Tabla_Combinada,
			                Calendario[Mes]
			            ),
			            "@EtiquetaMes",
			                SWITCH(
			                    Calendario[Mes],
			                    1, "ene",
			                    2, "feb",
			                    3, "mar",
			                    4, "abr",
			                    5, "may",
			                    6, "jun",
			                    7, "jul",
			                    8, "ago",
			                    9, "sep",
			                    10, "oct",
			                    11, "nov",
			                    12, "dic",
			                    ""
			                ),
			            "@Total",
			                CALCULATE(DISTINCTCOUNT(Tabla_Combinada[incident_number]))
			        ),
			        [@Total] > 0
			    )
			
			VAR __CantidadMeses =
			    COUNTROWS(__Meses)
			
			/* ============================================================
			   2. Anios visibles (primer nivel de fila)
			   ============================================================ */
			VAR __Anios =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES(Calendario[Anio]),
			            "@TotalAnio",
			                CALCULATE(DISTINCTCOUNT(Tabla_Combinada[incident_number]))
			        ),
			        [@TotalAnio] > 0
			    )
			
			VAR __SinDatos =
			    COUNTROWS(__Anios) = 0
			        || __CantidadMeses = 0
			
			/* ============================================================
			   3. Encabezado de meses (fila fija, columnas de la matriz)
			   ============================================================ */
			VAR __EncabezadoHTML =
			    "<div style='grid-column:1;position:sticky;top:0;left:0;z-index:3;background:#4A78F6;border-radius:4px 0 0 0;'></div>"
			        & CONCATENATEX(
			            __Meses,
			            "<div style='"
			                & "position:sticky;top:0;z-index:2;background:#4A78F6;color:#ffffff;"
			                & "font-size:8px;font-weight:700;text-align:center;padding:3px 1px;"
			                & "box-sizing:border-box;white-space:nowrap;overflow:hidden;'>"
			                & [@EtiquetaMes]
			            & "</div>",
			            "",
			            Calendario[Mes],
			            ASC
			        )
			
			/* ============================================================
			   4. Filas: Anio > Grupo de Soporte > Rol (tokens DS_Orden_Grupo / DS_Color_Grupo_Pastel / DS_Color_Grupo_Claro)
			   ============================================================ */
			VAR __FilasHTML =
			    CONCATENATEX(
			        __Anios,
			
			        VAR __AnioActual = Calendario[Anio]
			
			        VAR __GruposDelAnio =
			            FILTER(
			                ADDCOLUMNS(
			                    VALUES(tb_dim_fte[grupo_soporte]),
			                    "@TotalGrupo",
			                        CALCULATE(
			                            DISTINCTCOUNT(Tabla_Combinada[incident_number]),
			                            KEEPFILTERS(TREATAS({__AnioActual}, Calendario[Anio]))
			                        ),
			                    "@OrdenGrupo", [DS_Orden_Grupo],
			                    "@ColorGrupo", [DS_Color_Grupo_Pastel],
			                    "@ColorGrupoClaro", [DS_Color_Grupo_Claro]
			                ),
			                [@TotalGrupo] > 0
			            )
			
			        VAR __FilaAnioHTML =
			            "<div style='"
			                & "grid-column:1 / -1;background:#3D63C9;color:#ffffff;"
			                & "font-size:9px;font-weight:700;padding:3px 6px;margin-top:2px;"
			                & "border-radius:3px;box-sizing:border-box;'>"
			                & FORMAT(__AnioActual, "0000")
			            & "</div>"
			
			        VAR __FilasGruposHTML =
			            CONCATENATEX(
			                __GruposDelAnio,
			
			                VAR __GrupoActual = tb_dim_fte[grupo_soporte]
			                VAR __GrupoTexto =
			                    IF(ISBLANK(__GrupoActual) || __GrupoActual = "", "(Sin asignar)", __GrupoActual)
			                VAR __ColorGrupoActual = [@ColorGrupo]
			                VAR __ColorGrupoClaroActual = [@ColorGrupoClaro]
			
			                VAR __CeldasGrupoHTML =
			                    CONCATENATEX(
			                        __Meses,
			                        VAR __MesActual = Calendario[Mes]
			                        VAR __ValorGrupoMes =
			                            CALCULATE(
			                                DISTINCTCOUNT(Tabla_Combinada[incident_number]),
			                                KEEPFILTERS(TREATAS({__AnioActual}, Calendario[Anio])),
			                                KEEPFILTERS(TREATAS({__GrupoActual}, tb_dim_fte[grupo_soporte])),
			                                KEEPFILTERS(TREATAS({__MesActual}, Calendario[Mes]))
			                            )
			                        RETURN
			                            "<div style='"
			                                & "background:" & __ColorGrupoClaroActual & ";color:#12346C;"
			                                & "font-size:9px;font-weight:700;text-align:center;padding:2px 2px;"
			                                & "box-sizing:border-box;'>"
			                                & IF(__ValorGrupoMes > 0, FORMAT(__ValorGrupoMes, "#,0"), "-")
			                            & "</div>",
			                        "",
			                        Calendario[Mes],
			                        ASC
			                    )
			
			                VAR __FilaGrupoHTML =
			                    "<div title='" & __GrupoTexto & "' style='"
			                        & "background:" & __ColorGrupoActual & ";color:#12346C;"
			                        & "font-size:10px;font-weight:700;padding:3px 6px;box-sizing:border-box;"
			                        & "white-space:nowrap;'>"
			                        & __GrupoTexto
			                    & "</div>"
			                    & __CeldasGrupoHTML
			
			                VAR __RolesDelGrupo =
			                    FILTER(
			                        ADDCOLUMNS(
			                            VALUES(tb_dim_fte[rol]),
			                            "@TotalRol",
			                                CALCULATE(
			                                    DISTINCTCOUNT(Tabla_Combinada[incident_number]),
			                                    KEEPFILTERS(TREATAS({__AnioActual}, Calendario[Anio])),
			                                    KEEPFILTERS(TREATAS({__GrupoActual}, tb_dim_fte[grupo_soporte]))
			                                )
			                        ),
			                        [@TotalRol] > 0
			                    )
			
			                VAR __FilasRolesHTML =
			                    CONCATENATEX(
			                        __RolesDelGrupo,
			
			                        VAR __RolActual = tb_dim_fte[rol]
			                        VAR __RolTexto =
			                            IF(ISBLANK(__RolActual) || __RolActual = "", "(Sin rol)", __RolActual)
			
			                        VAR __CeldasRolHTML =
			                            CONCATENATEX(
			                                __Meses,
			                                VAR __MesActual2 = Calendario[Mes]
			                                VAR __ValorRolMes =
			                                    CALCULATE(
			                                        DISTINCTCOUNT(Tabla_Combinada[incident_number]),
			                                        KEEPFILTERS(TREATAS({__AnioActual}, Calendario[Anio])),
			                                        KEEPFILTERS(TREATAS({__GrupoActual}, tb_dim_fte[grupo_soporte])),
			                                        KEEPFILTERS(TREATAS({__RolActual}, tb_dim_fte[rol])),
			                                        KEEPFILTERS(TREATAS({__MesActual2}, Calendario[Mes]))
			                                    )
			                                RETURN
			                                    "<div style='"
			                                        & "background:#F5F7FB;color:#33415C;font-size:9px;font-weight:600;"
			                                        & "text-align:center;padding:2px 2px;box-sizing:border-box;"
			                                        & "border-bottom:1px solid #EEF3FA;'>"
			                                        & IF(__ValorRolMes > 0, FORMAT(__ValorRolMes, "#,0"), "-")
			                                    & "</div>",
			                                "",
			                                Calendario[Mes],
			                                ASC
			                            )
			
			                        RETURN
			                            "<div title='" & __RolTexto & "' style='"
			                                & "background:#F5F7FB;color:#33415C;font-size:9px;font-weight:600;"
			                                & "padding:2px 6px 2px 12px;box-sizing:border-box;white-space:nowrap;"
			                                & "border-bottom:1px solid #EEF3FA;'>"
			                                & __RolTexto
			                            & "</div>"
			                            & __CeldasRolHTML,
			
			                        "",
			                        tb_dim_fte[rol],
			                        ASC
			                    )
			
			                RETURN
			                    __FilaGrupoHTML & __FilasRolesHTML,
			
			                "",
			                [@OrdenGrupo],
			                ASC
			            )
			
			        RETURN
			            __FilaAnioHTML & __FilasGruposHTML,
			
			        "",
			        Calendario[Anio],
			        DESC
			    )
			
			/* ============================================================
			   5. Resultado final (usa tokens DS_Contenedor_Estilo / DS_Titulo_Estilo / DS_SinDatos_*)
			   ============================================================ */
			RETURN
			    "<div style='"
			        & "height:100%;"
			        & "max-height:100%;"
			        & [DS_Contenedor_Estilo]
			        & "'>"
			
			        & "<div style='" & [DS_Titulo_Estilo] & "'>"
			            & "Grupo de Soporte"
			        & "</div>"
			
			        & IF(
			            __SinDatos,
			
			            "<div style='" & [DS_SinDatos_Estilo] & "'>"
			                & [DS_SinDatos_Mensaje]
			            & "</div>",
			
			            "<div style='flex:1 1 auto;min-height:0;overflow-y:auto;overflow-x:auto;box-sizing:border-box;'>"
			                & "<div style='"
			                    & "display:grid;min-width:max-content;"
			                    & "grid-template-columns:max-content repeat(" & FORMAT(__CantidadMeses, "0") & ", minmax(22px,1fr));"
			                    & "column-gap:2px;row-gap:2px;width:100%;box-sizing:border-box;'>"
			                    & __EncabezadoHTML
			                    & __FilasHTML
			                & "</div>"
			            & "</div>"
			        )
			
			    & "</div>"
		displayFolder: Diseno HTML\Graficos
		lineageTag: e9219c77-1c9c-4e2e-9699-d2ec5275b868

	measure HTML_Volumetria_MatrizAgentes =
			
			
			VAR __Meses =
			    FILTER(
			        ADDCOLUMNS(
			            SUMMARIZE(
			                Tabla_Combinada,
			                Calendario[Mes]
			            ),
			            "@EtiquetaMes",
			                SWITCH(
			                    Calendario[Mes],
			                    1, "ene",
			                    2, "feb",
			                    3, "mar",
			                    4, "abr",
			                    5, "may",
			                    6, "jun",
			                    7, "jul",
			                    8, "ago",
			                    9, "sep",
			                    10, "oct",
			                    11, "nov",
			                    12, "dic",
			                    ""
			                ),
			            "@Total",
			                CALCULATE(DISTINCTCOUNT(Tabla_Combinada[incident_number]))
			        ),
			        [@Total] > 0
			    )
			
			VAR __CantidadMeses =
			    COUNTROWS(__Meses)
			
			VAR __Agentes =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES(tb_dim_fte[assigne_normalizado]),
			            "@TotalAgente",
			                CALCULATE(DISTINCTCOUNT(Tabla_Combinada[incident_number])),
			            "@ColorGrupo", [DS_Color_Grupo_Oscuro]
			        ),
			        [@TotalAgente] > 0
			    )
			
			VAR __SinDatos =
			    COUNTROWS(__Agentes) = 0
			        || __CantidadMeses = 0
			
			VAR __EncabezadoHTML =
			    "<div style='grid-column:1;position:sticky;top:0;left:0;z-index:3;background:#FAFBFD;'></div>"
			        & CONCATENATEX(
			            __Meses,
			            "<div style='"
			                & "position:sticky;top:0;z-index:2;background:#FAFBFD;color:#5B6B8C;"
			                & "font-size:9px;font-weight:700;text-align:center;padding:3px 1px;"
			                & "border-bottom:1px solid #DCE6F5;box-sizing:border-box;white-space:nowrap;'>"
			                & [@EtiquetaMes]
			            & "</div>",
			            "",
			            Calendario[Mes],
			            ASC
			        )
			
			VAR __FilasHTML =
			    CONCATENATEX(
			        __Agentes,
			
			        VAR __AgenteActual = tb_dim_fte[assigne_normalizado]
			        VAR __AgenteTexto =
			            IF(ISBLANK(__AgenteActual) || __AgenteActual = "", "(Sin asignar)", __AgenteActual)
			        VAR __ColorActual = [@ColorGrupo]
			
			        VAR __CeldasHTML =
			            CONCATENATEX(
			                __Meses,
			                VAR __MesActual = Calendario[Mes]
			                VAR __ValorCelda =
			                    CALCULATE(
			                        DISTINCTCOUNT(Tabla_Combinada[incident_number]),
			                        KEEPFILTERS(TREATAS({__AgenteActual}, tb_dim_fte[assigne_normalizado])),
			                        KEEPFILTERS(TREATAS({__MesActual}, Calendario[Mes]))
			                    )
			                RETURN
			                    "<div style='"
			                        & "color:#33415C;font-size:10px;font-weight:600;text-align:center;padding:2px 4px;"
			                        & "border-bottom:1px solid #EEF3FA;box-sizing:border-box;'>"
			                        & IF(__ValorCelda > 0, FORMAT(__ValorCelda, "#,0"), "-")
			                    & "</div>",
			                "",
			                Calendario[Mes],
			                ASC
			            )
			
			        RETURN
			            "<div style='"
			                & "border-left:2px solid " & __ColorActual & ";color:#3D4D68;"
			                & "font-size:10px;padding:2px 10px 2px 8px;box-sizing:border-box;"
			                & "border-bottom:1px solid #EEF3FA;white-space:nowrap;'>"
			                & __AgenteTexto
			            & "</div>"
			            & __CeldasHTML,
			
			        "",
			        [@TotalAgente],
			        DESC
			    )
			
			RETURN
			    "<div style='"
			        & "height:100%;"
			        & "max-height:100%;"
			        & [DS_Contenedor_Estilo]
			        & "'>"
			
			        & "<div style='" & [DS_Titulo_Estilo] & "'>"
			            & "Agente"
			        & "</div>"
			
			        & IF(
			            __SinDatos,
			
			            "<div style='" & [DS_SinDatos_Estilo] & "'>"
			                & [DS_SinDatos_Mensaje]
			            & "</div>",
			
			            "<div style='flex:1 1 auto;min-height:0;overflow-y:auto;overflow-x:auto;box-sizing:border-box;'>"
			                & "<div style='"
			                    & "display:grid;"
			                    & "grid-template-columns:max-content repeat(" & FORMAT(__CantidadMeses, "0") & ", minmax(28px,1fr));"
			                    & "column-gap:2px;width:100%;box-sizing:border-box;'>"
			                    & __EncabezadoHTML
			                    & __FilasHTML
			                & "</div>"
			            & "</div>"
			        )
			
			    & "</div>"
		displayFolder: Diseno HTML\Graficos
		lineageTag: 085b48f0-19e5-4f70-a3ff-c72596c11531


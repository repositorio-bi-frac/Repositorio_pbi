	measure HTML_Backlog_KPI_EnGestion =
			/// COMPONENTE DE CATALOGO: Tarjeta KPI por estado.
			/// Para reutilizarlo solo se cambia __Estado por el literal del modelo destino.
			/// La etiqueta y el icono se resuelven automaticamente.
			VAR __Estado = "Progreso"
			VAR __Etiqueta =
			    SWITCH(
			        __Estado,
			        "Progreso", "En curso",
			        "Asignado", "Asignado",
			        "Pendiente", "Pendiente",
			        "Cerrado", "Cerrado",
			        "Cancelado", "Cancelado",
			        __Estado
			    )
			VAR __Icono =
			    SWITCH(
			        __Estado,
			        "Progreso", [DS_Icono_EnCurso],
			        "Asignado", [DS_Icono_Asignado],
			        "Pendiente", [DS_Icono_Pendiente],
			        "Cerrado", [DS_Icono_Cerrado],
			        "Cancelado", [DS_Icono_Cancelado],
			        [DS_Icono_EnGestion]
			    )
			VAR __Valor =
			    CALCULATE(
			        DISTINCTCOUNT(Tabla_Combinada[incident_number]),
			        REMOVEFILTERS(tb_dim_status[status]),
			        TREATAS({ __Estado }, tb_dim_status[status])
			    )
			RETURN
			    "<div style='" & [DS_KPI_Tile_Estilo] & "'>"
			        & "<div style='" & [DS_KPI_Header_Estilo] & "'>"
			            & __Icono
			            & "<div style='" & [DS_KPI_Label_Estilo] & "'>" & __Etiqueta & "</div>"
			        & "</div>"
			        & "<div style='" & [DS_KPI_Valor_Estilo] & "'>" & FORMAT(COALESCE(__Valor, 0), "#,0") & "</div>"
			    & "</div>"
		displayFolder: Diseno HTML\Graficos
		lineageTag: 1a893339-e477-4703-862a-50f90fe6755d

	measure HTML_UltimaActualizacion =
			VAR __Fecha = [Ultima Actualizacion]
			RETURN
			    "<div style='" & [DS_KPI_Tile_Estilo] & "'>"
			        & "<div style='" & [DS_KPI_Header_Estilo] & "'>"
			            & [DS_Icono_Actualizacion]
			            & "<div style='" & [DS_KPI_Label_Estilo] & "'>Fecha Actualizacion</div>"
			        & "</div>"
			        & "<div style='font-size:12px;font-weight:700;color:" & [DS_Color_TituloTexto] & ";text-align:center;white-space:nowrap;'>"
			            & IF(ISBLANK(__Fecha), "-", FORMAT(__Fecha, "dd/mm/yyyy HH:mm"))
			        & "</div>"
			    & "</div>"
		displayFolder: Diseno HTML\Graficos
		lineageTag: ddf25d34-b9ae-42aa-b5b0-04878e844f52

	measure HTML_Backlog_Barras_AgenteEstado =
			
			
			/* ============================================================
			   1. Estados visibles, con orden y color
			   ============================================================ */
			VAR __EstadosBase =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES(tb_dim_status[status]),
			            "@TotalEstado", CALCULATE(DISTINCTCOUNT(Tabla_Combinada[incident_number]))
			        ),
			        [@TotalEstado] > 0
			    )
			
			VAR __Estados =
			    ADDCOLUMNS(
			        __EstadosBase,
			
			        "@Orden",
			            VAR __TotalActual = [@TotalEstado]
			            VAR __EstadoActual = tb_dim_status[status]
			            RETURN
			                COUNTROWS(
			                    FILTER(
			                        __EstadosBase,
			                        [@TotalEstado] > __TotalActual
			                            || ([@TotalEstado] = __TotalActual && tb_dim_status[status] < __EstadoActual)
			                    )
			                ) + 1,
			
			        "@Color",
			            VAR __TotalActual = [@TotalEstado]
			            VAR __EstadoActual = tb_dim_status[status]
			            VAR __OrdenActual =
			                COUNTROWS(
			                    FILTER(
			                        __EstadosBase,
			                        [@TotalEstado] > __TotalActual
			                            || ([@TotalEstado] = __TotalActual && tb_dim_status[status] < __EstadoActual)
			                    )
			                ) + 1
			            RETURN
			                SWITCH(
			                    MOD(__OrdenActual - 1, 8),
			                    0, "#1E4FAF", 1, "#4A78F6", 2, "#1198A5", 3, "#7B93D6",
			                    4, "#8FADF9", 5, "#5FC2CE", 6, "#2F5FC4", "#94A3B8"
			                )
			    )
			
			/* ============================================================
			   2. Agentes visibles
			   ============================================================ */
			VAR __AgentesBase =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES(tb_dim_fte[assigne_normalizado]),
			            "@TotalAgente", CALCULATE(DISTINCTCOUNT(Tabla_Combinada[incident_number]))
			        ),
			        [@TotalAgente] > 0
			    )
			
			VAR __CantidadAgentes =
			    COUNTROWS(__AgentesBase)
			
			VAR __SinDatos =
			    __CantidadAgentes = 0
			
			VAR __MaxTotal =
			    MAXX(__AgentesBase, [@TotalAgente])
			
			/* ============================================================
			   3. Celdas de la grilla: nombre | barra apilada | total
			      (3 celdas por agente; el grid alinea las columnas y la
			      columna de nombres se dimensiona al nombre mas largo)
			   ============================================================ */
			VAR __FilasHTML =
			    CONCATENATEX(
			        __AgentesBase,
			
			        VAR __AgenteActual = tb_dim_fte[assigne_normalizado]
			        VAR __TotalActual = [@TotalAgente]
			        VAR __AgenteTexto =
			            IF(ISBLANK(__AgenteActual) || __AgenteActual = "", "(Sin asignar)", __AgenteActual)
			
			        VAR __SegmentosHTML =
			            CONCATENATEX(
			                __Estados,
			
			                VAR __EstadoActual = tb_dim_status[status]
			                VAR __ColorActual = [@Color]
			                VAR __Valor =
			                    CALCULATE(
			                        DISTINCTCOUNT(Tabla_Combinada[incident_number]),
			                        KEEPFILTERS(TREATAS({__AgenteActual}, tb_dim_fte[assigne_normalizado])),
			                        KEEPFILTERS(TREATAS({__EstadoActual}, tb_dim_status[status]))
			                    )
			                VAR __AnchoPct =
			                    DIVIDE(__Valor, MAX(__MaxTotal, 1), 0) * 100
			
			                RETURN
			                    IF(
			                        __Valor > 0,
			                        "<div title='" & __AgenteTexto & " | " & __EstadoActual & ": " & FORMAT(__Valor, "#,0") & "'"
			                            & " style='width:" & FORMAT(__AnchoPct, "0.00", "en-US") & "%;"
			                            & "height:100%;background:" & __ColorActual & ";box-sizing:border-box;'>"
			                            & "</div>",
			                        ""
			                    ),
			
			                "",
			                [@Orden],
			                ASC
			            )
			
			        RETURN
			            "<div title='" & __AgenteTexto & "'"
			                & " style='font-size:8px;color:#3D4D68;white-space:nowrap;"
			                & "overflow:hidden;text-overflow:ellipsis;text-align:right;'>"
			                & __AgenteTexto
			            & "</div>"
			
			            & "<div style='height:11px;display:flex;flex-direction:row;min-width:0;"
			                & "background:#F1F4FA;border-radius:2px;overflow:hidden;'>"
			                & __SegmentosHTML
			            & "</div>"
			
			            & "<div style='font-size:8px;font-weight:700;color:#12346C;text-align:right;white-space:nowrap;'>"
			                & FORMAT(__TotalActual, "#,0")
			            & "</div>",
			
			        "",
			        [@TotalAgente],
			        DESC
			    )
			
			/* ============================================================
			   4. Leyenda
			   ============================================================ */
			VAR __LeyendaHTML =
			    CONCATENATEX(
			        __Estados,
			        VAR __EtiquetaActual =
			            IF(ISBLANK(tb_dim_status[status]) || tb_dim_status[status] = "", "(Sin estado)", tb_dim_status[status])
			        RETURN
			            "<span style='display:inline-flex;align-items:center;gap:4px;margin-right:8px;font-size:8px;color:#53627C;white-space:nowrap;'>"
			                & "<span style='width:7px;height:7px;border-radius:2px;background:" & [@Color] & ";display:inline-block;'></span>"
			                & __EtiquetaActual
			            & "</span>",
			        "",
			        [@Orden],
			        ASC
			    )
			
			RETURN
			    "<div style='"
			        & "height:100%;"
			        & "max-height:100%;"
			        & [DS_Contenedor_Estilo]
			        & "'>"
			
			        & "<div style='" & [DS_Titulo_Estilo] & "'>Casos por Agente y Estado</div>"
			
			        & IF(
			            __SinDatos,
			
			            "<div style='" & [DS_SinDatos_Estilo] & "'>" & [DS_SinDatos_Mensaje] & "</div>",
			
			            "<div style='flex:1 1 auto;min-height:0;display:flex;flex-direction:column;overflow:hidden;'>"
			
			                & "<div style='flex:1 1 auto;min-height:0;overflow-y:auto;overflow-x:hidden;box-sizing:border-box;padding-right:2px;'>"
			                    & "<div style='display:grid;"
			                        & "grid-template-columns:fit-content(120px) minmax(50px,1fr) max-content;"
			                        & "column-gap:5px;row-gap:3px;align-items:center;width:100%;box-sizing:border-box;'>"
			                        & __FilasHTML
			                    & "</div>"
			                & "</div>"
			
			                & "<div style='display:flex;align-items:center;justify-content:center;flex-wrap:wrap;"
			                    & "height:18px;min-height:18px;overflow:hidden;padding-top:2px;"
			                    & "border-top:1px solid #EEF3FA;box-sizing:border-box;'>"
			                    & __LeyendaHTML
			                & "</div>"
			
			            & "</div>"
			        )
			
			    & "</div>"
		displayFolder: Diseno HTML\Graficos
		lineageTag: b2c3d4e5-0003-4f33-9b33-300000000003

	measure HTML_Backlog_Lineas_Balance =
			
			VAR __AnchoSVG = 460
			VAR __AltoSVG = 138
			
			VAR __MargenX = 24
			VAR __MargenSuperior = 16
			VAR __MargenInferior = 12
			
			VAR __AnchoPlot =
			    __AnchoSVG - (__MargenX * 2)
			
			VAR __AltoPlot =
			    __AltoSVG - __MargenSuperior - __MargenInferior
			
			/* ============================================================
			   1. Datos por año y mes
			   ============================================================ */
			VAR __CategoriasBase =
			    FILTER(
			        ADDCOLUMNS(
			            SUMMARIZE(
			                Tabla_Combinada,
			                Calendario[Anio],
			                Calendario[Mes]
			            ),
			
			            "@Orden",
			                Calendario[Anio] * 100
			                    + Calendario[Mes],
			
			            "@Etiqueta",
			                SWITCH(
			                    Calendario[Mes],
			                    1, "ene",
			                    2, "feb",
			                    3, "mar",
			                    4, "abr",
			                    5, "may",
			                    6, "jun",
			                    7, "jul",
			                    8, "ago",
			                    9, "sep",
			                    10, "oct",
			                    11, "nov",
			                    12, "dic",
			                    ""
			                )
			                    & " "
			                    & RIGHT(
			                        FORMAT(
			                            Calendario[Anio],
			                            "0000"
			                        ),
			                        2
			                    ),
			
			            "@Aperturados",
			                CALCULATE([Aperturados]),
			
			            "@Balance",
			                CALCULATE([Balance]),
			
			            "@Cerrados",
			                CALCULATE([Cerrados])
			        ),
			
			        NOT(
			            ISBLANK([@Aperturados])
			                && ISBLANK([@Balance])
			                && ISBLANK([@Cerrados])
			        )
			    )
			
			VAR __Categorias =
			    ADDCOLUMNS(
			        __CategoriasBase,
			
			        "@Indice",
			            VAR __OrdenActual = [@Orden]
			            RETURN
			                COUNTROWS(
			                    FILTER(
			                        __CategoriasBase,
			                        [@Orden] < __OrdenActual
			                    )
			                )
			    )
			
			VAR __CantidadCategorias =
			    COUNTROWS(__Categorias)
			
			VAR __SinDatos =
			    __CantidadCategorias = 0
			
			/* ============================================================
			   2. Máximo y mínimo del gráfico
			   Se consideran solo valores no vacíos.
			   ============================================================ */
			VAR __ValoresSeries =
			    UNION(
			        SELECTCOLUMNS(
			            FILTER(
			                __Categorias,
			                NOT ISBLANK([@Aperturados])
			            ),
			            "@Valor", [@Aperturados]
			        ),
			        SELECTCOLUMNS(
			            FILTER(
			                __Categorias,
			                NOT ISBLANK([@Balance])
			            ),
			            "@Valor", [@Balance]
			        ),
			        SELECTCOLUMNS(
			            FILTER(
			                __Categorias,
			                NOT ISBLANK([@Cerrados])
			            ),
			            "@Valor", [@Cerrados]
			        )
			    )
			
			VAR __MaxVal =
			    MAXX(
			        __ValoresSeries,
			        [@Valor]
			    )
			
			VAR __MinVal =
			    MINX(
			        __ValoresSeries,
			        [@Valor]
			    )
			
			VAR __MaxEscala =
			    MAX(
			        COALESCE(__MaxVal, 0),
			        0
			    )
			
			VAR __MinEscala =
			    MIN(
			        COALESCE(__MinVal, 0),
			        0
			    )
			
			VAR __Rango =
			    MAX(
			        __MaxEscala - __MinEscala,
			        1
			    )
			
			/* ============================================================
			   3. Coordenada X común
			   ============================================================ */
			VAR __SeparacionX =
			    IF(
			        __CantidadCategorias > 1,
			        DIVIDE(
			            __AnchoPlot,
			            __CantidadCategorias - 1,
			            0
			        ),
			        0
			    )
			
			/* ============================================================
			   4. Puntos de Aperturados
			   ============================================================ */
			VAR __PuntosAperturados =
			    CONCATENATEX(
			        FILTER(
			            __Categorias,
			            NOT ISBLANK([@Aperturados])
			        ),
			
			        VAR __Indice = [@Indice]
			
			        VAR __X =
			            IF(
			                __CantidadCategorias > 1,
			                __MargenX + (__Indice * __SeparacionX),
			                __AnchoSVG / 2
			            )
			
			        VAR __Y =
			            __MargenSuperior
			                + __AltoPlot
			                - DIVIDE(
			                    [@Aperturados] - __MinEscala,
			                    __Rango,
			                    0
			                ) * __AltoPlot
			
			        RETURN
			            FORMAT(__X, "0.00", "en-US")
			                & ","
			                & FORMAT(__Y, "0.00", "en-US"),
			
			        " ",
			        [@Indice],
			        ASC
			    )
			
			/* ============================================================
			   5. Puntos de Balance
			   ============================================================ */
			VAR __PuntosBalance =
			    CONCATENATEX(
			        FILTER(
			            __Categorias,
			            NOT ISBLANK([@Balance])
			        ),
			
			        VAR __Indice = [@Indice]
			
			        VAR __X =
			            IF(
			                __CantidadCategorias > 1,
			                __MargenX + (__Indice * __SeparacionX),
			                __AnchoSVG / 2
			            )
			
			        VAR __Y =
			            __MargenSuperior
			                + __AltoPlot
			                - DIVIDE(
			                    [@Balance] - __MinEscala,
			                    __Rango,
			                    0
			                ) * __AltoPlot
			
			        RETURN
			            FORMAT(__X, "0.00", "en-US")
			                & ","
			                & FORMAT(__Y, "0.00", "en-US"),
			
			        " ",
			        [@Indice],
			        ASC
			    )
			
			/* ============================================================
			   6. Puntos de Cerrados
			   ============================================================ */
			VAR __PuntosCerrados =
			    CONCATENATEX(
			        FILTER(
			            __Categorias,
			            NOT ISBLANK([@Cerrados])
			        ),
			
			        VAR __Indice = [@Indice]
			
			        VAR __X =
			            IF(
			                __CantidadCategorias > 1,
			                __MargenX + (__Indice * __SeparacionX),
			                __AnchoSVG / 2
			            )
			
			        VAR __Y =
			            __MargenSuperior
			                + __AltoPlot
			                - DIVIDE(
			                    [@Cerrados] - __MinEscala,
			                    __Rango,
			                    0
			                ) * __AltoPlot
			
			        RETURN
			            FORMAT(__X, "0.00", "en-US")
			                & ","
			                & FORMAT(__Y, "0.00", "en-US"),
			
			        " ",
			        [@Indice],
			        ASC
			    )
			
			/* ============================================================
			   7. Marcadores y etiquetas de Aperturados
			   ============================================================ */
			VAR __MarcadoresAperturados =
			    CONCATENATEX(
			        FILTER(
			            __Categorias,
			            NOT ISBLANK([@Aperturados])
			        ),
			
			        VAR __Indice = [@Indice]
			        VAR __Valor = [@Aperturados]
			
			        VAR __X =
			            IF(
			                __CantidadCategorias > 1,
			                __MargenX + (__Indice * __SeparacionX),
			                __AnchoSVG / 2
			            )
			
			        VAR __Y =
			            __MargenSuperior
			                + __AltoPlot
			                - DIVIDE(
			                    __Valor - __MinEscala,
			                    __Rango,
			                    0
			                ) * __AltoPlot
			
			        RETURN
			            "<circle"
			                & " cx='" & FORMAT(__X, "0.00", "en-US") & "'"
			                & " cy='" & FORMAT(__Y, "0.00", "en-US") & "'"
			                & " r='4'"
			                & " fill='#4A78F6'"
			                & " stroke='#FFFFFF'"
			                & " stroke-width='2'>"
			                & "<title>Aperturados: "
			                & FORMAT(__Valor, "#,0")
			                & "</title>"
			                & "</circle>"
			                &
			            "<text"
			                & " x='" & FORMAT(__X, "0.00", "en-US") & "'"
			                & " y='" & FORMAT(__Y - 8, "0.00", "en-US") & "'"
			                & " text-anchor='middle'"
			                & " font-family='Segoe UI'"
			                & " font-size='9'"
			                & " font-weight='600'"
			                & " fill='#4A78F6'>"
			                & FORMAT(__Valor, "#,0")
			                & "</text>",
			
			        "",
			        [@Indice],
			        ASC
			    )
			
			/* ============================================================
			   8. Marcadores y etiquetas de Balance
			   ============================================================ */
			VAR __MarcadoresBalance =
			    CONCATENATEX(
			        FILTER(
			            __Categorias,
			            NOT ISBLANK([@Balance])
			        ),
			
			        VAR __Indice = [@Indice]
			        VAR __Valor = [@Balance]
			
			        VAR __X =
			            IF(
			                __CantidadCategorias > 1,
			                __MargenX + (__Indice * __SeparacionX),
			                __AnchoSVG / 2
			            )
			
			        VAR __Y =
			            __MargenSuperior
			                + __AltoPlot
			                - DIVIDE(
			                    __Valor - __MinEscala,
			                    __Rango,
			                    0
			                ) * __AltoPlot
			
			        RETURN
			            "<circle"
			                & " cx='" & FORMAT(__X, "0.00", "en-US") & "'"
			                & " cy='" & FORMAT(__Y, "0.00", "en-US") & "'"
			                & " r='4'"
			                & " fill='#1E4FAF'"
			                & " stroke='#FFFFFF'"
			                & " stroke-width='2'>"
			                & "<title>Balance: "
			                & FORMAT(__Valor, "#,0")
			                & "</title>"
			                & "</circle>"
			                &
			            "<text"
			                & " x='" & FORMAT(__X, "0.00", "en-US") & "'"
			                & " y='" & FORMAT(__Y + 14, "0.00", "en-US") & "'"
			                & " text-anchor='middle'"
			                & " font-family='Segoe UI'"
			                & " font-size='9'"
			                & " font-weight='600'"
			                & " fill='#1E4FAF'>"
			                & FORMAT(__Valor, "#,0")
			                & "</text>",
			
			        "",
			        [@Indice],
			        ASC
			    )
			
			/* ============================================================
			   9. Marcadores y etiquetas de Cerrados
			   ============================================================ */
			VAR __MarcadoresCerrados =
			    CONCATENATEX(
			        FILTER(
			            __Categorias,
			            NOT ISBLANK([@Cerrados])
			        ),
			
			        VAR __Indice = [@Indice]
			        VAR __Valor = [@Cerrados]
			
			        VAR __X =
			            IF(
			                __CantidadCategorias > 1,
			                __MargenX + (__Indice * __SeparacionX),
			                __AnchoSVG / 2
			            )
			
			        VAR __Y =
			            __MargenSuperior
			                + __AltoPlot
			                - DIVIDE(
			                    __Valor - __MinEscala,
			                    __Rango,
			                    0
			                ) * __AltoPlot
			
			        RETURN
			            "<circle"
			                & " cx='" & FORMAT(__X, "0.00", "en-US") & "'"
			                & " cy='" & FORMAT(__Y, "0.00", "en-US") & "'"
			                & " r='4'"
			                & " fill='#1198A5'"
			                & " stroke='#FFFFFF'"
			                & " stroke-width='2'>"
			                & "<title>Cerrados: "
			                & FORMAT(__Valor, "#,0")
			                & "</title>"
			                & "</circle>"
			                &
			            "<text"
			                & " x='" & FORMAT(__X, "0.00", "en-US") & "'"
			                & " y='" & FORMAT(__Y - 8, "0.00", "en-US") & "'"
			                & " text-anchor='middle'"
			                & " font-family='Segoe UI'"
			                & " font-size='9'"
			                & " font-weight='600'"
			                & " fill='#1198A5'>"
			                & FORMAT(__Valor, "#,0")
			                & "</text>",
			
			        "",
			        [@Indice],
			        ASC
			    )
			
			/* ============================================================
			   10. Línea de cero
			   ============================================================ */
			VAR __ZeroY =
			    __MargenSuperior
			        + __AltoPlot
			        - DIVIDE(
			            0 - __MinEscala,
			            __Rango,
			            0
			        ) * __AltoPlot
			
			/* ============================================================
			   11. Etiquetas del eje X
			   ============================================================ */
			VAR __EtiquetasHTML =
			    CONCATENATEX(
			        __Categorias,
			
			        "<div style='"
			            & "flex:1 1 0;"
			            & "min-width:0;"
			            & "text-align:center;"
			            & "font-size:8px;"
			            & "color:#62708A;"
			            & "white-space:nowrap;"
			            & "overflow:hidden;"
			            & "'>"
			            & [@Etiqueta]
			            & "</div>",
			
			        "",
			        [@Indice],
			        ASC
			    )
			
			RETURN
			    "<div style='"
			        & "height:100%;"
			        & "max-height:100%;"
			        & [DS_Contenedor_Estilo]
			        & "'>"
			
			        & "<div style='"
			        & [DS_Titulo_Estilo]
			        & "'>"
			        & "Balance de Producción SOC"
			        & "</div>"
			
			        & IF(
			            __SinDatos,
			
			            "<div style='"
			                & [DS_SinDatos_Estilo]
			                & "'>"
			                & [DS_SinDatos_Mensaje]
			                & "</div>",
			
			            "<div style='"
			                & "flex:1 1 auto;"
			                & "min-height:0;"
			                & "display:flex;"
			                & "flex-direction:column;"
			                & "overflow:hidden;"
			                & "'>"
			
			                & "<div style='"
			                    & "height:138px;"
			                    & "box-sizing:border-box;"
			                    & "overflow:hidden;"
			                    & "position:relative;"
			                    & "'>"
			
			                    & "<svg"
			                        & " xmlns='http://www.w3.org/2000/svg'"
			                        & " width='100%'"
			                        & " height='100%'"
			                        & " viewBox='0 0 "
			                        & FORMAT(__AnchoSVG, "0", "en-US")
			                        & " "
			                        & FORMAT(__AltoSVG, "0", "en-US")
			                        & "'"
			                        & " preserveAspectRatio='none'"
			                        & " style='display:block;'>"
			
			                        & "<line"
			                            & " x1='" & FORMAT(__MargenX, "0", "en-US") & "'"
			                            & " y1='" & FORMAT(__ZeroY, "0.00", "en-US") & "'"
			                            & " x2='" & FORMAT(__AnchoSVG - __MargenX, "0", "en-US") & "'"
			                            & " y2='" & FORMAT(__ZeroY, "0.00", "en-US") & "'"
			                            & " stroke='#DCE6F5'"
			                            & " stroke-width='1'"
			                            & " stroke-dasharray='5,5'>"
			                        & "</line>"
			
			                        & IF(
			                            COUNTROWS(
			                                FILTER(
			                                    __Categorias,
			                                    NOT ISBLANK([@Aperturados])
			                                )
			                            ) >= 2,
			                            "<polyline points='"
			                                & __PuntosAperturados
			                                & "' fill='none'"
			                                & " stroke='#4A78F6'"
			                                & " stroke-width='3'"
			                                & " stroke-linecap='round'"
			                                & " stroke-linejoin='round'>"
			                                & "</polyline>",
			                            ""
			                        )
			
			                        & IF(
			                            COUNTROWS(
			                                FILTER(
			                                    __Categorias,
			                                    NOT ISBLANK([@Balance])
			                                )
			                            ) >= 2,
			                            "<polyline points='"
			                                & __PuntosBalance
			                                & "' fill='none'"
			                                & " stroke='#1E4FAF'"
			                                & " stroke-width='3'"
			                                & " stroke-linecap='round'"
			                                & " stroke-linejoin='round'>"
			                                & "</polyline>",
			                            ""
			                        )
			
			                        & IF(
			                            COUNTROWS(
			                                FILTER(
			                                    __Categorias,
			                                    NOT ISBLANK([@Cerrados])
			                                )
			                            ) >= 2,
			                            "<polyline points='"
			                                & __PuntosCerrados
			                                & "' fill='none'"
			                                & " stroke='#1198A5'"
			                                & " stroke-width='3'"
			                                & " stroke-linecap='round'"
			                                & " stroke-linejoin='round'>"
			                                & "</polyline>",
			                            ""
			                        )
			
			                        & __MarcadoresAperturados
			                        & __MarcadoresBalance
			                        & __MarcadoresCerrados
			
			                    & "</svg>"
			                & "</div>"
			
			                & "<div style='"
			                    & "display:flex;"
			                    & "flex-direction:row;"
			                    & "height:16px;"
			                    & "min-height:16px;"
			                    & "box-sizing:border-box;"
			                    & "padding:0 4px;"
			                    & "'>"
			                    & __EtiquetasHTML
			                & "</div>"
			
			                & "<div style='"
			                    & "display:flex;"
			                    & "align-items:center;"
			                    & "justify-content:center;"
			                    & "flex-wrap:wrap;"
			                    & "height:16px;"
			                    & "min-height:16px;"
			                    & "overflow:hidden;"
			                    & "'>"
			
			                    & "<span style='display:inline-flex;align-items:center;gap:4px;margin-right:10px;font-size:8px;color:#53627C;'>"
			                        & "<span style='width:10px;height:2px;background:#4A78F6;display:inline-block;'></span>"
			                        & "Aperturados"
			                    & "</span>"
			
			                    & "<span style='display:inline-flex;align-items:center;gap:4px;margin-right:10px;font-size:8px;color:#53627C;'>"
			                        & "<span style='width:10px;height:2px;background:#1E4FAF;display:inline-block;'></span>"
			                        & "Balance"
			                    & "</span>"
			
			                    & "<span style='display:inline-flex;align-items:center;gap:4px;font-size:8px;color:#53627C;'>"
			                        & "<span style='width:10px;height:2px;background:#1198A5;display:inline-block;'></span>"
			                        & "Cerrados"
			                    & "</span>"
			
			                & "</div>"
			            & "</div>"
			        )
			
			    & "</div>"
		displayFolder: Diseno HTML\Graficos
		lineageTag: b2c3d4e5-0004-4f33-9b33-300000000004

	measure HTML_Backlog_Area_Backlog =
			
			VAR __AnchoSVG = 460
			VAR __AltoSVG = 138
			
			VAR __MargenX = 24
			VAR __MargenSuperior = 16
			VAR __MargenInferior = 12
			
			VAR __AnchoPlot =
			    __AnchoSVG - (__MargenX * 2)
			
			VAR __AltoPlot =
			    __AltoSVG - __MargenSuperior - __MargenInferior
			
			/* ============================================================
			   1. Datos por anio y mes
			   ============================================================ */
			VAR __CategoriasBase =
			    FILTER(
			        ADDCOLUMNS(
			            SUMMARIZE(
			                Tabla_Combinada,
			                Calendario[Anio],
			                Calendario[Mes]
			            ),
			
			            "@Orden",
			                Calendario[Anio] * 100
			                    + Calendario[Mes],
			
			            "@Etiqueta",
			                SWITCH(
			                    Calendario[Mes],
			                    1, "ene",
			                    2, "feb",
			                    3, "mar",
			                    4, "abr",
			                    5, "may",
			                    6, "jun",
			                    7, "jul",
			                    8, "ago",
			                    9, "sep",
			                    10, "oct",
			                    11, "nov",
			                    12, "dic",
			                    ""
			                )
			                    & " "
			                    & RIGHT(
			                        FORMAT(
			                            Calendario[Anio],
			                            "0000"
			                        ),
			                        2
			                    ),
			
			            "@RTBalance",
			                CALCULATE([RT_Balance])
			        ),
			
			        NOT(ISBLANK([@RTBalance]))
			    )
			
			VAR __Categorias =
			    ADDCOLUMNS(
			        __CategoriasBase,
			
			        "@Indice",
			            VAR __OrdenActual = [@Orden]
			            RETURN
			                COUNTROWS(
			                    FILTER(
			                        __CategoriasBase,
			                        [@Orden] < __OrdenActual
			                    )
			                )
			    )
			
			VAR __CantidadCategorias =
			    COUNTROWS(__Categorias)
			
			VAR __SinDatos =
			    __CantidadCategorias = 0
			
			/* ============================================================
			   2. Maximo y minimo del grafico
			   ============================================================ */
			VAR __MaxVal =
			    MAXX(
			        __Categorias,
			        [@RTBalance]
			    )
			
			VAR __MinVal =
			    MINX(
			        __Categorias,
			        [@RTBalance]
			    )
			
			VAR __MaxEscala =
			    MAX(
			        COALESCE(__MaxVal, 0),
			        0
			    )
			
			VAR __MinEscala =
			    MIN(
			        COALESCE(__MinVal, 0),
			        0
			    )
			
			VAR __Rango =
			    MAX(
			        __MaxEscala - __MinEscala,
			        1
			    )
			
			/* ============================================================
			   3. Coordenada X comun
			   ============================================================ */
			VAR __SeparacionX =
			    IF(
			        __CantidadCategorias > 1,
			        DIVIDE(
			            __AnchoPlot,
			            __CantidadCategorias - 1,
			            0
			        ),
			        0
			    )
			
			/* ============================================================
			   4. Puntos de la linea
			   ============================================================ */
			VAR __PuntosLinea =
			    CONCATENATEX(
			        __Categorias,
			
			        VAR __Indice = [@Indice]
			
			        VAR __X =
			            IF(
			                __CantidadCategorias > 1,
			                __MargenX + (__Indice * __SeparacionX),
			                __AnchoSVG / 2
			            )
			
			        VAR __Y =
			            __MargenSuperior
			                + __AltoPlot
			                - DIVIDE(
			                    [@RTBalance] - __MinEscala,
			                    __Rango,
			                    0
			                ) * __AltoPlot
			
			        RETURN
			            FORMAT(__X, "0.00", "en-US")
			                & ","
			                & FORMAT(__Y, "0.00", "en-US"),
			
			        " ",
			        [@Indice],
			        ASC
			    )
			
			/* ============================================================
			   5. Marcadores y etiquetas
			   ============================================================ */
			VAR __MarcadoresHTML =
			    CONCATENATEX(
			        __Categorias,
			
			        VAR __Indice = [@Indice]
			        VAR __Valor = [@RTBalance]
			
			        VAR __X =
			            IF(
			                __CantidadCategorias > 1,
			                __MargenX + (__Indice * __SeparacionX),
			                __AnchoSVG / 2
			            )
			
			        VAR __Y =
			            __MargenSuperior
			                + __AltoPlot
			                - DIVIDE(
			                    __Valor - __MinEscala,
			                    __Rango,
			                    0
			                ) * __AltoPlot
			
			        RETURN
			            "<circle"
			                & " cx='" & FORMAT(__X, "0.00", "en-US") & "'"
			                & " cy='" & FORMAT(__Y, "0.00", "en-US") & "'"
			                & " r='4'"
			                & " fill='#1E4FAF'"
			                & " stroke='#FFFFFF'"
			                & " stroke-width='2'>"
			                & "<title>Backlog: "
			                & FORMAT(__Valor, "#,0")
			                & "</title>"
			                & "</circle>"
			                &
			            "<text"
			                & " x='" & FORMAT(__X, "0.00", "en-US") & "'"
			                & " y='" & FORMAT(__Y - 8, "0.00", "en-US") & "'"
			                & " text-anchor='middle'"
			                & " font-family='Segoe UI'"
			                & " font-size='9'"
			                & " font-weight='600'"
			                & " fill='#1E4FAF'>"
			                & FORMAT(__Valor, "#,0")
			                & "</text>",
			
			        "",
			        [@Indice],
			        ASC
			    )
			
			/* ============================================================
			   6. Linea de cero
			   ============================================================ */
			VAR __ZeroY =
			    __MargenSuperior
			        + __AltoPlot
			        - DIVIDE(
			            0 - __MinEscala,
			            __Rango,
			            0
			        ) * __AltoPlot
			
			/* ============================================================
			   7. Ruta del area
			   ============================================================ */
			VAR __PrimerX =
			    __MargenX
			
			VAR __UltimoX =
			    IF(
			        __CantidadCategorias > 1,
			        __MargenX + ((__CantidadCategorias - 1) * __SeparacionX),
			        __AnchoSVG / 2
			    )
			
			VAR __RutaArea =
			    "M " & FORMAT(__PrimerX, "0.00", "en-US") & " " & FORMAT(__ZeroY, "0.00", "en-US")
			        & " L " & __PuntosLinea
			        & " L " & FORMAT(__UltimoX, "0.00", "en-US") & " " & FORMAT(__ZeroY, "0.00", "en-US")
			        & " Z"
			
			/* ============================================================
			   8. Etiquetas del eje X
			   ============================================================ */
			VAR __EtiquetasHTML =
			    CONCATENATEX(
			        __Categorias,
			
			        "<div style='"
			            & "flex:1 1 0;"
			            & "min-width:0;"
			            & "text-align:center;"
			            & "font-size:8px;"
			            & "color:#62708A;"
			            & "white-space:nowrap;"
			            & "overflow:hidden;"
			            & "'>"
			            & [@Etiqueta]
			            & "</div>",
			
			        "",
			        [@Indice],
			        ASC
			    )
			
			RETURN
			    "<div style='"
			        & "height:100%;"
			        & "max-height:100%;"
			        & [DS_Contenedor_Estilo]
			        & "'>"
			
			        & "<div style='"
			        & [DS_Titulo_Estilo]
			        & "'>"
			        & "Backlog SOC"
			        & "</div>"
			
			        & IF(
			            __SinDatos,
			
			            "<div style='"
			                & [DS_SinDatos_Estilo]
			                & "'>"
			                & [DS_SinDatos_Mensaje]
			                & "</div>",
			
			            "<div style='"
			                & "flex:1 1 auto;"
			                & "min-height:0;"
			                & "display:flex;"
			                & "flex-direction:column;"
			                & "overflow:hidden;"
			                & "'>"
			
			                & "<div style='"
			                    & "height:138px;"
			                    & "box-sizing:border-box;"
			                    & "overflow:hidden;"
			                    & "position:relative;"
			                    & "'>"
			
			                    & "<svg"
			                        & " xmlns='http://www.w3.org/2000/svg'"
			                        & " width='100%'"
			                        & " height='100%'"
			                        & " viewBox='0 0 "
			                        & FORMAT(__AnchoSVG, "0", "en-US")
			                        & " "
			                        & FORMAT(__AltoSVG, "0", "en-US")
			                        & "'"
			                        & " preserveAspectRatio='none'"
			                        & " style='display:block;'>"
			
			                        & "<line"
			                            & " x1='" & FORMAT(__MargenX, "0", "en-US") & "'"
			                            & " y1='" & FORMAT(__ZeroY, "0.00", "en-US") & "'"
			                            & " x2='" & FORMAT(__AnchoSVG - __MargenX, "0", "en-US") & "'"
			                            & " y2='" & FORMAT(__ZeroY, "0.00", "en-US") & "'"
			                            & " stroke='#DCE6F5'"
			                            & " stroke-width='1'"
			                            & " stroke-dasharray='5,5'>"
			                        & "</line>"
			
			                        & IF(
			                            __CantidadCategorias >= 2,
			                            "<path d='"
			                                & __RutaArea
			                                & "' fill='#4A78F6'"
			                                & " fill-opacity='0.25'"
			                                & " stroke='none'>"
			                                & "</path>",
			                            ""
			                        )
			
			                        & IF(
			                            __CantidadCategorias >= 2,
			                            "<polyline points='"
			                                & __PuntosLinea
			                                & "' fill='none'"
			                                & " stroke='#1E4FAF'"
			                                & " stroke-width='3'"
			                                & " stroke-linecap='round'"
			                                & " stroke-linejoin='round'>"
			                                & "</polyline>",
			                            ""
			                        )
			
			                        & __MarcadoresHTML
			
			                    & "</svg>"
			                & "</div>"
			
			                & "<div style='"
			                    & "display:flex;"
			                    & "flex-direction:row;"
			                    & "height:16px;"
			                    & "min-height:16px;"
			                    & "box-sizing:border-box;"
			                    & "padding:0 4px;"
			                    & "'>"
			                    & __EtiquetasHTML
			                & "</div>"
			
			                & "<div style='"
			                    & "display:flex;"
			                    & "align-items:center;"
			                    & "justify-content:center;"
			                    & "flex-wrap:wrap;"
			                    & "height:16px;"
			                    & "min-height:16px;"
			                    & "overflow:hidden;"
			                    & "'>"
			
			                    & "<span style='display:inline-flex;align-items:center;gap:4px;font-size:8px;color:#53627C;'>"
			                        & "<span style='width:10px;height:2px;background:#1E4FAF;display:inline-block;'></span>"
			                        & "Backlog acumulado"
			                    & "</span>"
			
			                & "</div>"
			            & "</div>"
			        )
			
			    & "</div>"
		displayFolder: Diseno HTML\Graficos
		lineageTag: b2c3d4e5-0005-4f33-9b33-300000000005

	measure DS_Icono_Q2 = "<svg width='17' height='17' viewBox='0 0 24 24' fill='none' style='flex-shrink:0;'><path d='M3 12h5' stroke='#C7D2E8' stroke-width='1.3'/><path d='M3 9v6' stroke='#C7D2E8' stroke-width='1.3'/><path d='M8 7h8v10H8z' stroke='#C7D2E8' stroke-width='1.5' fill='none'/><path d='M16 12h5' stroke='#C7D2E8' stroke-width='1.3'/><path d='M21 9v6' stroke='#C7D2E8' stroke-width='1.3'/><path d='M12 6v12' stroke='#1E4FAF' stroke-width='2.6' stroke-linecap='round'/></svg>"
		displayFolder: Diseno HTML\Tokens\Iconos
		lineageTag: c3d4e5f6-0003-4a44-9c44-400000000003

	measure HTML_KPI_Q2 =
			VAR __Dias = PERCENTILE.INC(Tabla_Combinada[duracion_resolucion_soc_dias], 0.5)
			VAR __TotalSeg = __Dias * 86400
			VAR __H = INT(DIVIDE(__TotalSeg, 3600, 0))
			VAR __M = INT(DIVIDE(MOD(__TotalSeg, 3600), 60, 0))
			VAR __S = INT(MOD(__TotalSeg, 60))
			VAR __Texto =
			    IF(
			        ISBLANK(__Dias),
			        "-",
			        FORMAT(__H, "00") & ":" & FORMAT(__M, "00") & ":" & FORMAT(__S, "00")
			    )
			RETURN
			    "<div style='" & [DS_KPI_Tile_Estilo] & "'>"
			        & "<div style='" & [DS_KPI_Header_Estilo] & "'>"
			            & [DS_Icono_Q2]
			            & "<div style='" & [DS_KPI_Label_Estilo] & "'>Q2 (mediana)</div>"
			        & "</div>"
			        & "<div style='font-size:14px;font-weight:700;color:" & [DS_Color_TituloTexto] & ";text-align:center;white-space:nowrap;'>"
			            & __Texto
			        & "</div>"
			    & "</div>"
		displayFolder: Diseno HTML\Graficos
		lineageTag: c3d4e5f6-0013-4a44-9c44-400000000013

	measure HTML_Cuartiles_Tiempos =
			
			
			/* ============================================================
			   1. Cuartiles
			   ============================================================ */
			VAR __Q1 = PERCENTILE.INC(Tabla_Combinada[duracion_resolucion_soc_dias], 0.25)
			VAR __Q2 = PERCENTILE.INC(Tabla_Combinada[duracion_resolucion_soc_dias], 0.5)
			VAR __Q3 = PERCENTILE.INC(Tabla_Combinada[duracion_resolucion_soc_dias], 0.75)
			VAR __Min = MIN(Tabla_Combinada[duracion_resolucion_soc_dias])
			VAR __Max = MAX(Tabla_Combinada[duracion_resolucion_soc_dias])
			
			VAR __SinDatos = ISBLANK(__Max)
			
			VAR __IQR = __Q3 - __Q1
			
			/* ============================================================
			   2. Vallas 1.5 x IQR y extremos de los bigotes
			      (el bigote llega al ultimo caso REAL dentro de la valla)
			   ============================================================ */
			VAR __VallaSup = __Q3 + 1.5 * __IQR
			VAR __VallaInf = __Q1 - 1.5 * __IQR
			
			VAR __FilasConDato =
			    FILTER(
			        Tabla_Combinada,
			        NOT ISBLANK(Tabla_Combinada[duracion_resolucion_soc_dias])
			    )
			
			VAR __TotalCasos = COUNTROWS(__FilasConDato)
			
			VAR __BigoteSup =
			    MAXX(
			        FILTER(__FilasConDato, Tabla_Combinada[duracion_resolucion_soc_dias] <= __VallaSup),
			        Tabla_Combinada[duracion_resolucion_soc_dias]
			    )
			
			VAR __BigoteInf =
			    MINX(
			        FILTER(__FilasConDato, Tabla_Combinada[duracion_resolucion_soc_dias] >= __VallaInf),
			        Tabla_Combinada[duracion_resolucion_soc_dias]
			    )
			
			VAR __BSup = COALESCE(__BigoteSup, __Max)
			VAR __BInf = COALESCE(__BigoteInf, __Min)
			
			VAR __AtipicosSup =
			    COALESCE(
			        COUNTROWS(FILTER(__FilasConDato, Tabla_Combinada[duracion_resolucion_soc_dias] > __VallaSup)),
			        0
			    )
			
			VAR __AtipicosInf =
			    COALESCE(
			        COUNTROWS(FILTER(__FilasConDato, Tabla_Combinada[duracion_resolucion_soc_dias] < __VallaInf)),
			        0
			    )
			
			VAR __HayAtipicos = __AtipicosSup > 0
			
			/* ============================================================
			   3. Escala horizontal
			      Si hay atipicos el eje se recorta en el bigote (84%) y se
			      reserva la derecha para los puntos atipicos y el maximo.
			   ============================================================ */
			VAR __EscalaIni = 4
			VAR __EscalaFin = IF(__HayAtipicos, 84, 96)
			VAR __EscalaAncho = __EscalaFin - __EscalaIni
			VAR __RangoEje = __BSup - __BInf
			VAR __Degenerado = ISBLANK(__RangoEje) || __RangoEje = 0
			
			VAR __PosBInf = IF(__Degenerado, 50, __EscalaIni)
			VAR __PosQ1 = IF(__Degenerado, 50, __EscalaIni + DIVIDE(__Q1 - __BInf, __RangoEje, 0) * __EscalaAncho)
			VAR __PosQ2 = IF(__Degenerado, 50, __EscalaIni + DIVIDE(__Q2 - __BInf, __RangoEje, 0) * __EscalaAncho)
			VAR __PosQ3 = IF(__Degenerado, 50, __EscalaIni + DIVIDE(__Q3 - __BInf, __RangoEje, 0) * __EscalaAncho)
			VAR __PosBSup = IF(__Degenerado, 50, __EscalaFin)
			
			VAR __PctBInf = FORMAT(__PosBInf, "0.00", "en-US") & "%"
			VAR __PctQ1 = FORMAT(__PosQ1, "0.00", "en-US") & "%"
			VAR __PctQ2 = FORMAT(__PosQ2, "0.00", "en-US") & "%"
			VAR __PctQ3 = FORMAT(__PosQ3, "0.00", "en-US") & "%"
			VAR __PctBSup = FORMAT(__PosBSup, "0.00", "en-US") & "%"
			
			VAR __AnchoBigote = FORMAT(MAX(__PosBSup - __PosBInf, 0), "0.00", "en-US") & "%"
			VAR __AnchoCaja = FORMAT(MAX(__PosQ3 - __PosQ1, 0.8), "0.00", "en-US") & "%"
			
			/* ============================================================
			   4. Textos HH:MM:SS (soporta duraciones mayores a 24 h)
			   ============================================================ */
			VAR __S_Q1 = __Q1 * 86400
			VAR __T_Q1 = FORMAT(INT(DIVIDE(__S_Q1, 3600, 0)), "00") & ":" & FORMAT(INT(DIVIDE(MOD(__S_Q1, 3600), 60, 0)), "00") & ":" & FORMAT(INT(MOD(__S_Q1, 60)), "00")
			
			VAR __S_Q2 = __Q2 * 86400
			VAR __T_Q2 = FORMAT(INT(DIVIDE(__S_Q2, 3600, 0)), "00") & ":" & FORMAT(INT(DIVIDE(MOD(__S_Q2, 3600), 60, 0)), "00") & ":" & FORMAT(INT(MOD(__S_Q2, 60)), "00")
			
			VAR __S_Q3 = __Q3 * 86400
			VAR __T_Q3 = FORMAT(INT(DIVIDE(__S_Q3, 3600, 0)), "00") & ":" & FORMAT(INT(DIVIDE(MOD(__S_Q3, 3600), 60, 0)), "00") & ":" & FORMAT(INT(MOD(__S_Q3, 60)), "00")
			
			VAR __S_IQR = __IQR * 86400
			VAR __T_IQR = FORMAT(INT(DIVIDE(__S_IQR, 3600, 0)), "00") & ":" & FORMAT(INT(DIVIDE(MOD(__S_IQR, 3600), 60, 0)), "00") & ":" & FORMAT(INT(MOD(__S_IQR, 60)), "00")
			
			VAR __S_BInf = __BInf * 86400
			VAR __T_BInf = FORMAT(INT(DIVIDE(__S_BInf, 3600, 0)), "00") & ":" & FORMAT(INT(DIVIDE(MOD(__S_BInf, 3600), 60, 0)), "00") & ":" & FORMAT(INT(MOD(__S_BInf, 60)), "00")
			
			VAR __S_BSup = __BSup * 86400
			VAR __T_BSup = FORMAT(INT(DIVIDE(__S_BSup, 3600, 0)), "00") & ":" & FORMAT(INT(DIVIDE(MOD(__S_BSup, 3600), 60, 0)), "00") & ":" & FORMAT(INT(MOD(__S_BSup, 60)), "00")
			
			VAR __S_Valla = __VallaSup * 86400
			VAR __T_Valla = FORMAT(INT(DIVIDE(__S_Valla, 3600, 0)), "00") & ":" & FORMAT(INT(DIVIDE(MOD(__S_Valla, 3600), 60, 0)), "00") & ":" & FORMAT(INT(MOD(__S_Valla, 60)), "00")
			
			VAR __S_Max = __Max * 86400
			VAR __T_Max = FORMAT(INT(DIVIDE(__S_Max, 3600, 0)), "00") & ":" & FORMAT(INT(DIVIDE(MOD(__S_Max, 3600), 60, 0)), "00") & ":" & FORMAT(INT(MOD(__S_Max, 60)), "00")
			
			/* ============================================================
			   5. Descripcion automatica
			   ============================================================ */
			VAR __PctAtipicos =
			    DIVIDE(__AtipicosSup + __AtipicosInf, __TotalCasos, 0)
			
			VAR __FraseMediana =
			    "La mitad de los casos se resuelve en menos de <b>" & __T_Q2 & "</b>."
			
			VAR __FraseCaja =
			    " El 50% central (Q1-Q3) va de <b>" & __T_Q1 & "</b> a <b>" & __T_Q3 & "</b>"
			        & ", una dispersion de " & __T_IQR & "."
			
			VAR __FraseBigotes =
			    " El rango habitual llega hasta " & __T_BSup & "."
			
			VAR __FraseAtipicos =
			    IF(
			        __HayAtipicos,
			        " Hay <b>" & FORMAT(__AtipicosSup + __AtipicosInf, "#,0") & "</b> "
			            & IF(__AtipicosSup + __AtipicosInf = 1, "caso atipico", "casos atipicos")
			            & " (" & FORMAT(__PctAtipicos, "0.0%", "en-US") & " del total) por encima de "
			            & __T_Valla & ", con un maximo de <b>" & __T_Max & "</b>.",
			        " Sin casos atipicos; el maximo registrado es <b>" & __T_Max & "</b>."
			    )
			
			VAR __FraseSesgo =
			    IF(
			        __Q3 = __Q2 && NOT ISBLANK(__Q2),
			        " Atencion: Q2 y Q3 coinciden, lo que indica que al menos un cuarto de los casos comparte exactamente el mismo valor.",
			        ""
			    )
			
			VAR __FraseTotal =
			    " Calculado sobre " & FORMAT(__TotalCasos, "#,0") & " "
			        & IF(__TotalCasos = 1, "caso", "casos") & " con duracion registrada."
			
			VAR __Descripcion =
			    __FraseMediana & __FraseCaja & __FraseBigotes & __FraseAtipicos & __FraseSesgo & __FraseTotal
			
			RETURN
			    "<div style='"
			        & "height:100%;"
			        & "max-height:100%;"
			        & [DS_Contenedor_Estilo]
			        & "'>"
			
			        & "<div style='" & [DS_Titulo_Estilo] & "'>Tiempo de Resolucion por Cuartiles</div>"
			
			        & IF(
			            __SinDatos,
			
			            "<div style='" & [DS_SinDatos_Estilo] & "'>" & [DS_SinDatos_Mensaje] & "</div>",
			
			            /* ---------- Area del grafico ---------- */
			            "<div style='position:relative;height:124px;flex:0 0 124px;box-sizing:border-box;overflow:hidden;'>"
			
			                /* Bigote */
			                & "<div style='position:absolute;left:" & __PctBInf & ";width:" & __AnchoBigote & ";"
			                    & "top:64px;height:3px;background:#C7D2E8;'></div>"
			
			                /* Tope inferior */
			                & "<div title='Minimo dentro del rango habitual: " & __T_BInf & "'"
			                    & " style='position:absolute;left:" & __PctBInf & ";top:51px;transform:translateX(-50%);"
			                    & "width:3px;height:29px;background:#1E4FAF;border-radius:2px;'></div>"
			
			                /* Tope superior */
			                & "<div title='Maximo dentro del rango habitual (valla 1.5xIQR): " & __T_BSup & "'"
			                    & " style='position:absolute;left:" & __PctBSup & ";top:51px;transform:translateX(-50%);"
			                    & "width:3px;height:29px;background:#1E4FAF;border-radius:2px;'></div>"
			
			                /* Caja Q1-Q3 */
			                & "<div title='Rango intercuartilico Q1-Q3: " & __T_Q1 & " a " & __T_Q3 & "'"
			                    & " style='position:absolute;left:" & __PctQ1 & ";width:" & __AnchoCaja & ";"
			                    & "top:45px;height:41px;background:rgba(74,120,246,0.30);"
			                    & "border:1.5px solid #1E4FAF;border-radius:3px;box-sizing:border-box;'></div>"
			
			                /* Mediana */
			                & "<div title='Q2 mediana: " & __T_Q2 & "'"
			                    & " style='position:absolute;left:" & __PctQ2 & ";top:38px;transform:translateX(-50%);"
			                    & "width:3px;height:55px;background:#0F2D68;border-radius:2px;'></div>"
			
			                /* Etiquetas extremos arriba */
			                & "<div style='position:absolute;left:" & __PctBInf & ";top:20px;transform:translateX(-50%);"
			                    & "font-size:10px;font-weight:700;color:#1E4FAF;white-space:nowrap;'>" & __T_BInf & "</div>"
			                & "<div style='position:absolute;left:" & __PctBInf & ";top:7px;transform:translateX(-50%);"
			                    & "font-size:8px;color:#8090AA;white-space:nowrap;'>min.</div>"
			
			                & "<div style='position:absolute;left:" & __PctBSup & ";top:20px;transform:translateX(-50%);"
			                    & "font-size:10px;font-weight:700;color:#1E4FAF;white-space:nowrap;'>" & __T_BSup & "</div>"
			                & "<div style='position:absolute;left:" & __PctBSup & ";top:7px;transform:translateX(-50%);"
			                    & "font-size:8px;color:#8090AA;white-space:nowrap;'>"
			                    & IF(__HayAtipicos, "valla", "max.") & "</div>"
			
			                /* Mediana debajo */
			                & "<div style='position:absolute;left:" & __PctQ2 & ";top:92px;transform:translateX(-50%);"
			                    & "font-size:11px;font-weight:700;color:#0F2D68;white-space:nowrap;'>" & __T_Q2 & "</div>"
			                & "<div style='position:absolute;left:" & __PctQ2 & ";top:106px;transform:translateX(-50%);"
			                    & "font-size:8px;color:#62708A;white-space:nowrap;'>Q2 mediana</div>"
			
			                /* Q1 y Q3 */
			                & "<div style='position:absolute;left:" & __PctQ1 & ";top:92px;transform:translateX(-50%);"
			                    & "font-size:9px;color:#5B6B8C;white-space:nowrap;'>Q1</div>"
			                & "<div style='position:absolute;left:" & __PctQ3 & ";top:92px;transform:translateX(-50%);"
			                    & "font-size:9px;color:#5B6B8C;white-space:nowrap;'>Q3</div>"
			
			                /* Atipicos: puntos + maximo anotado */
			                & IF(
			                    __HayAtipicos,
			                    "<div style='position:absolute;left:88%;top:61px;width:8px;height:8px;border-radius:50%;"
			                        & "background:#1E4FAF;opacity:0.75;'></div>"
			                        & "<div style='position:absolute;left:93%;top:63px;width:7px;height:7px;border-radius:50%;"
			                        & "background:#1E4FAF;opacity:0.5;'></div>"
			                        & "<div style='position:absolute;right:0;top:20px;text-align:right;'>"
			                            & "<div style='font-size:8px;color:#8090AA;white-space:nowrap;'>"
			                            & FORMAT(__AtipicosSup, "#,0") & " atipicos</div>"
			                            & "<div style='font-size:10px;font-weight:700;color:#1E4FAF;white-space:nowrap;'>"
			                            & __T_Max & "</div>"
			                        & "</div>",
			                    ""
			                )
			
			            & "</div>"
			
			            /* ---------- Descripcion automatica ---------- */
			            & "<div style='flex:1 1 auto;min-height:0;padding-top:5px;margin-top:2px;"
			                & "border-top:1px solid #EEF3FA;box-sizing:border-box;overflow:hidden;"
			                & "font-size:9.5px;line-height:1.45;color:#5B6B8C;'>"
			                & __Descripcion
			            & "</div>"
			        )
			
			    & "</div>"
		displayFolder: Diseno HTML\Graficos
		lineageTag: c3d4e5f6-0021-4a44-9c44-400000000021

	measure HTML_Registro_Tabla =
			
			
			VAR __Tipo = SELECTEDVALUE(Tabla_Combinada[tipo_definitivo])
			VAR __Titulo =
			    SWITCH(
			        TRUE(),
			        __Tipo = "REQUERIMIENTO", "Detalle REQ",
			        __Tipo = "INCIDENCIA", "Detalle INC",
			        __Tipo = "ACTIVIDAD", "Detalle ACT",
			        "Detalle"
			    )
			
			VAR __Filas =
			    ADDCOLUMNS(
			        Tabla_Combinada,
			        "@Estado", RELATED(tb_dim_status[status])
			    )
			
			VAR __CantidadFilas =
			    COUNTROWS(__Filas)
			
			VAR __SinDatos =
			    __CantidadFilas = 0
			
			VAR __Encabezados =
			    {
			        "N. Incidente", "Estado", "Descripcion", "Fecha Notificacion", "Duracion SOC"
			    }
			
			VAR __EncabezadoHTML =
			    CONCATENATEX(
			        __Encabezados,
			        "<div style='"
			            & "color:#5B6B8C;font-size:9px;font-weight:700;padding:3px 6px;"
			            & "border-bottom:1px solid #DCE6F5;box-sizing:border-box;position:sticky;top:0;"
			            & "background:#FAFBFD;white-space:nowrap;z-index:2;'>"
			            & [Value]
			        & "</div>"
			    )
			
			VAR __FilasHTML =
			    CONCATENATEX(
			        __Filas,
			
			        VAR __EstadoTxt =
			            IF(ISBLANK([@Estado]) || [@Estado] = "", "-", [@Estado])
			        VAR __NumeroTxt =
			            IF(ISBLANK(Tabla_Combinada[incident_number]), "-", Tabla_Combinada[incident_number])
			        VAR __DescTxt =
			            IF(
			                ISBLANK(Tabla_Combinada[description]) || Tabla_Combinada[description] = "",
			                "-",
			                Tabla_Combinada[description]
			            )
			        VAR __FechaTxt =
			            IF(
			                ISBLANK(Tabla_Combinada[fecha_y_hora_de_notificacion]), "-",
			                FORMAT(Tabla_Combinada[fecha_y_hora_de_notificacion], "dd/mm/yy HH:mm")
			            )
			        VAR __Dias = Tabla_Combinada[duracion_resolucion_soc_dias]
			        VAR __TotalSeg = __Dias * 86400
			        VAR __H = INT(DIVIDE(__TotalSeg, 3600, 0))
			        VAR __M = INT(DIVIDE(MOD(__TotalSeg, 3600), 60, 0))
			        VAR __S = INT(MOD(__TotalSeg, 60))
			        VAR __DuracionTxt =
			            IF(
			                ISBLANK(__Dias),
			                "-",
			                FORMAT(__H, "00") & ":" & FORMAT(__M, "00") & ":" & FORMAT(__S, "00")
			            )
			
			        RETURN
			            "<div style='"
			                & "border-left:2px solid #4A78F6;color:#3D4D68;font-size:9px;"
			                & "padding:3px 6px;box-sizing:border-box;border-bottom:1px solid #EEF3FA;"
			                & "white-space:nowrap;'>"
			                & __NumeroTxt
			            & "</div>"
			            & "<div style='"
			                & "color:#3D4D68;font-size:9px;font-weight:600;padding:3px 6px;box-sizing:border-box;"
			                & "border-bottom:1px solid #EEF3FA;white-space:nowrap;overflow:hidden;"
			                & "text-overflow:ellipsis;'>"
			                & __EstadoTxt
			            & "</div>"
			            & "<div title='" & __DescTxt & "' style='"
			                & "color:#62708A;font-size:9px;padding:3px 6px;box-sizing:border-box;"
			                & "border-bottom:1px solid #EEF3FA;white-space:nowrap;overflow:hidden;"
			                & "text-overflow:ellipsis;min-width:0;'>"
			                & __DescTxt
			            & "</div>"
			            & "<div style='"
			                & "color:#62708A;font-size:9px;padding:3px 6px;box-sizing:border-box;"
			                & "border-bottom:1px solid #EEF3FA;white-space:nowrap;'>"
			                & __FechaTxt
			            & "</div>"
			            & "<div style='"
			                & "color:#12346C;font-size:9px;font-weight:600;padding:3px 6px;box-sizing:border-box;"
			                & "border-bottom:1px solid #EEF3FA;white-space:nowrap;text-align:right;'>"
			                & __DuracionTxt
			            & "</div>",
			
			        "",
			        Tabla_Combinada[fecha_y_hora_de_notificacion],
			        DESC
			    )
			
			RETURN
			    "<div style='"
			        & "height:100%;"
			        & "max-height:100%;"
			        & [DS_Contenedor_Estilo]
			        & "'>"
			
			        & "<div style='" & [DS_Titulo_Estilo] & "'>" & __Titulo & "</div>"
			
			        & IF(
			            __SinDatos,
			
			            "<div style='" & [DS_SinDatos_Estilo] & "'>" & [DS_SinDatos_Mensaje] & "</div>",
			
			            "<div style='flex:1 1 auto;min-height:0;overflow-y:auto;overflow-x:hidden;box-sizing:border-box;'>"
			                & "<div style='"
			                    & "display:grid;"
			                    & "grid-template-columns:max-content max-content minmax(80px,1fr) max-content max-content;"
			                    & "width:100%;box-sizing:border-box;'>"
			                    & __EncabezadoHTML
			                    & __FilasHTML
			                & "</div>"
			            & "</div>"
			        )
			
			    & "</div>"
		displayFolder: Diseno HTML\Graficos
		lineageTag: c3d4e5f6-0022-4a44-9c44-400000000022

	measure HTML_Donut_Estados =
			
			VAR __RadioExt = 52
			VAR __RadioInt = 30
			VAR __CX = 90
			VAR __CY = 90
			VAR __RadioDentro = 41
			
			/* Factor de ancho por digito. Subirlo hace la regla mas
			   conservadora (mas valores salen afuera). */
			VAR __AnchoPorDigito = 5.2
			
			VAR __CategoriasBase =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES(tb_dim_status[status]),
			            "@Total", CALCULATE(DISTINCTCOUNT(Tabla_Combinada[incident_number]))
			        ),
			        [@Total] > 0
			    )
			
			VAR __TotalGeneral = SUMX(__CategoriasBase, [@Total])
			
			VAR __Categorias =
			    ADDCOLUMNS(
			        __CategoriasBase,
			        "@Orden",
			            VAR __TotalActual = [@Total]
			            VAR __EstadoActual = tb_dim_status[status]
			            RETURN
			                COUNTROWS(
			                    FILTER(
			                        __CategoriasBase,
			                        [@Total] > __TotalActual
			                            || ([@Total] = __TotalActual && tb_dim_status[status] < __EstadoActual)
			                    )
			                ) + 1
			    )
			
			/* Se marca por fila si el valor entra en su propio arco:
			   largo del arco a la altura de la etiqueta vs ancho del texto */
			VAR __ConFlags =
			    ADDCOLUMNS(
			        __Categorias,
			        "@Cabe",
			            VAR __Frac = DIVIDE([@Total], __TotalGeneral, 0)
			            VAR __LargoArco = __Frac * 2 * PI() * __RadioDentro
			            VAR __AnchoTexto = LEN(FORMAT([@Total], "#,0")) * __AnchoPorDigito
			            RETURN IF(__LargoArco >= __AnchoTexto, 1, 0)
			    )
			
			VAR __CantidadCategorias = COUNTROWS(__ConFlags)
			
			VAR __SinDatos = __CantidadCategorias = 0 || __TotalGeneral = 0
			
			VAR __SlicesHTML =
			    CONCATENATEX(
			        __ConFlags,
			        VAR __OrdenActual = [@Orden]
			        VAR __TotalActual = [@Total]
			        VAR __EtiquetaActual =
			            IF(ISBLANK(tb_dim_status[status]) || tb_dim_status[status] = "", "(Sin estado)", tb_dim_status[status])
			        VAR __ColorActual =
			            SWITCH(
			                MOD(__OrdenActual - 1, 8),
			                0, "#1E4FAF", 1, "#4A78F6", 2, "#1198A5", 3, "#7B93D6",
			                4, "#8FADF9", 5, "#5FC2CE", 6, "#2F5FC4", "#94A3B8"
			            )
			        VAR __AntesTotal = SUMX(FILTER(__ConFlags, [@Orden] < __OrdenActual), [@Total])
			        VAR __FraccionInicio = DIVIDE(__AntesTotal, __TotalGeneral, 0)
			        VAR __FraccionFin = DIVIDE(__AntesTotal + __TotalActual, __TotalGeneral, 0)
			        VAR __AnguloInicio = __FraccionInicio * 2 * PI() - PI() / 2
			        VAR __AnguloFin = __FraccionFin * 2 * PI() - PI() / 2
			        VAR __X1o = __CX + __RadioExt * COS(__AnguloInicio)
			        VAR __Y1o = __CY + __RadioExt * SIN(__AnguloInicio)
			        VAR __X2o = __CX + __RadioExt * COS(__AnguloFin)
			        VAR __Y2o = __CY + __RadioExt * SIN(__AnguloFin)
			        VAR __X1i = __CX + __RadioInt * COS(__AnguloFin)
			        VAR __Y1i = __CY + __RadioInt * SIN(__AnguloFin)
			        VAR __X2i = __CX + __RadioInt * COS(__AnguloInicio)
			        VAR __Y2i = __CY + __RadioInt * SIN(__AnguloInicio)
			        VAR __GranArco = IF(__FraccionFin - __FraccionInicio > 0.5, 1, 0)
			        RETURN
			            IF(
			                __FraccionFin > __FraccionInicio,
			                "<path d='M "
			                    & FORMAT(__X1o, "0.00", "en-US") & " " & FORMAT(__Y1o, "0.00", "en-US")
			                    & " A " & FORMAT(__RadioExt, "0", "en-US") & " " & FORMAT(__RadioExt, "0", "en-US") & " 0 " & FORMAT(__GranArco, "0") & " 1 "
			                    & FORMAT(__X2o, "0.00", "en-US") & " " & FORMAT(__Y2o, "0.00", "en-US")
			                    & " L " & FORMAT(__X1i, "0.00", "en-US") & " " & FORMAT(__Y1i, "0.00", "en-US")
			                    & " A " & FORMAT(__RadioInt, "0", "en-US") & " " & FORMAT(__RadioInt, "0", "en-US") & " 0 " & FORMAT(__GranArco, "0") & " 0 "
			                    & FORMAT(__X2i, "0.00", "en-US") & " " & FORMAT(__Y2i, "0.00", "en-US")
			                    & " Z' fill='" & __ColorActual & "'>"
			                    & "<title>" & __EtiquetaActual & ": " & FORMAT(__TotalActual, "#,0")
			                    & " (" & FORMAT(__FraccionFin - __FraccionInicio, "0.0%", "en-US") & ")</title>"
			                    & "</path>",
			                ""
			            ),
			        "",
			        [@Orden],
			        ASC
			    )
			
			/* Valores: adentro en blanco si caben; si no, afuera con guia
			   en codo, apiladas alternando lado para no colisionar */
			VAR __ValoresHTML =
			    CONCATENATEX(
			        __ConFlags,
			        VAR __OrdenActual = [@Orden]
			        VAR __TotalActual = [@Total]
			        VAR __Cabe = [@Cabe]
			        VAR __TextoValor = FORMAT(__TotalActual, "#,0")
			        VAR __ColorActual =
			            SWITCH(
			                MOD(__OrdenActual - 1, 8),
			                0, "#1E4FAF", 1, "#4A78F6", 2, "#1198A5", 3, "#7B93D6",
			                4, "#8FADF9", 5, "#5FC2CE", 6, "#2F5FC4", "#94A3B8"
			            )
			        VAR __ColorOscuro =
			            SWITCH(
			                __ColorActual,
			                "#1E4FAF", "#163B85",
			                "#4A78F6", "#2F5AC9",
			                "#1198A5", "#0C707A",
			                "#7B93D6", "#5B6FA8",
			                "#8FADF9", "#6E8FD4",
			                "#5FC2CE", "#3E93A0",
			                "#2F5FC4", "#234896",
			                "#94A3B8", "#6B7A8F",
			                "#12346C"
			            )
			        VAR __AntesTotal = SUMX(FILTER(__ConFlags, [@Orden] < __OrdenActual), [@Total])
			        VAR __FraccionInicio = DIVIDE(__AntesTotal, __TotalGeneral, 0)
			        VAR __FraccionFin = DIVIDE(__AntesTotal + __TotalActual, __TotalGeneral, 0)
			        VAR __FraccionSlice = __FraccionFin - __FraccionInicio
			        VAR __AnguloMedio = ((__FraccionInicio + __FraccionFin) / 2) * 2 * PI() - PI() / 2
			
			        /* Posicion adentro */
			        VAR __TXd = __CX + __RadioDentro * COS(__AnguloMedio)
			        VAR __TYd = __CY + __RadioDentro * SIN(__AnguloMedio)
			
			        /* Orden entre las que salen afuera, para apilarlas */
			        VAR __IndiceFuera =
			            COUNTROWS(
			                FILTER(
			                    __ConFlags,
			                    [@Orden] < __OrdenActual && [@Cabe] = 0
			                )
			            ) + 0
			        VAR __IdxF = COALESCE(__IndiceFuera, 0)
			        VAR __Lado = IF(MOD(__IdxF, 2) = 0, -1, 1)
			        VAR __FilaF = INT(DIVIDE(__IdxF, 2, 0))
			        VAR __LabelY = __CY - __RadioExt - 13 + (__FilaF * 12)
			
			        /* Punto de anclaje sobre el arco */
			        VAR __PX = __CX + (__RadioExt + 1) * COS(__AnguloMedio)
			        VAR __PY = __CY + (__RadioExt + 1) * SIN(__AnguloMedio)
			        VAR __CodoX = __CX + __Lado * 9
			        VAR __FinX = __CX + __Lado * 24
			        VAR __TextoX = __CX + __Lado * 27
			        VAR __Anchor = IF(__Lado = -1, "end", "start")
			
			        RETURN
			            IF(
			                __FraccionSlice <= 0,
			                "",
			                IF(
			                    __Cabe = 1,
			
			                    "<text"
			                        & " x='" & FORMAT(__TXd, "0.00", "en-US") & "'"
			                        & " y='" & FORMAT(__TYd + 3, "0.00", "en-US") & "'"
			                        & " text-anchor='middle'"
			                        & " font-family='Segoe UI'"
			                        & " font-size='11'"
			                        & " font-weight='700'"
			                        & " fill='#FFFFFF'>"
			                        & __TextoValor
			                        & "</text>",
			
			                    "<polyline points='"
			                        & FORMAT(__PX, "0.00", "en-US") & "," & FORMAT(__PY, "0.00", "en-US") & " "
			                        & FORMAT(__CodoX, "0.00", "en-US") & "," & FORMAT(__LabelY, "0.00", "en-US") & " "
			                        & FORMAT(__FinX, "0.00", "en-US") & "," & FORMAT(__LabelY, "0.00", "en-US")
			                        & "' fill='none' stroke='" & __ColorOscuro & "' stroke-width='1.1'></polyline>"
			                        & "<circle cx='" & FORMAT(__PX, "0.00", "en-US") & "'"
			                        & " cy='" & FORMAT(__PY, "0.00", "en-US") & "' r='1.7'"
			                        & " fill='" & __ColorOscuro & "'></circle>"
			                        & "<text"
			                        & " x='" & FORMAT(__TextoX, "0.00", "en-US") & "'"
			                        & " y='" & FORMAT(__LabelY + 3, "0.00", "en-US") & "'"
			                        & " text-anchor='" & __Anchor & "'"
			                        & " font-family='Segoe UI'"
			                        & " font-size='10'"
			                        & " font-weight='700'"
			                        & " fill='" & __ColorOscuro & "'>"
			                        & __TextoValor
			                        & "</text>"
			                )
			            ),
			        "",
			        [@Orden],
			        ASC
			    )
			
			VAR __LeyendaHTML =
			    CONCATENATEX(
			        __ConFlags,
			        VAR __OrdenActual = [@Orden]
			        VAR __ColorActual =
			            SWITCH(
			                MOD(__OrdenActual - 1, 8),
			                0, "#1E4FAF", 1, "#4A78F6", 2, "#1198A5", 3, "#7B93D6",
			                4, "#8FADF9", 5, "#5FC2CE", 6, "#2F5FC4", "#94A3B8"
			            )
			        VAR __EtiquetaActual =
			            IF(ISBLANK(tb_dim_status[status]) || tb_dim_status[status] = "", "(Sin estado)", tb_dim_status[status])
			        RETURN
			            "<div style='display:flex;align-items:center;gap:5px;font-size:10px;color:#53627C;white-space:nowrap;margin-bottom:6px;'>"
			                & "<span style='width:9px;height:9px;min-width:9px;border-radius:2px;background:" & __ColorActual & ";display:inline-block;'></span>"
			                & "<span style='min-width:0;overflow:hidden;text-overflow:ellipsis;' title='" & __EtiquetaActual & "'>" & __EtiquetaActual & "</span>"
			                & "<span style='color:#8090AA;font-weight:600;flex:0 0 auto;'>(" & FORMAT(DIVIDE([@Total], __TotalGeneral, 0), "0%", "en-US") & ")</span>"
			            & "</div>",
			        "",
			        [@Orden],
			        ASC
			    )
			
			RETURN
			    "<div style='"
			        & "height:100%;"
			        & "max-height:100%;"
			        & [DS_Contenedor_Estilo]
			        & "'>"
			        & "<div style='" & [DS_Titulo_Estilo] & "'>Distribucion por Estado</div>"
			        & IF(
			            __SinDatos,
			            "<div style='" & [DS_SinDatos_Estilo] & "'>" & [DS_SinDatos_Mensaje] & "</div>",
			            "<div style='flex:1 1 auto;min-height:0;display:flex;flex-direction:row;align-items:stretch;justify-content:center;gap:8px;overflow:hidden;'>"
			                & "<svg"
			                    & " xmlns='http://www.w3.org/2000/svg'"
			                    & " width='100%' height='100%'"
			                    & " viewBox='0 0 180 180'"
			                    & " preserveAspectRatio='xMidYMid meet'" & " style='flex:0 0 45%;display:block;'>"
			                    & __SlicesHTML
			                    & __ValoresHTML
			                    & "<text x='" & FORMAT(__CX, "0", "en-US") & "' y='" & FORMAT(__CY + 3, "0", "en-US") & "'"
			                        & " text-anchor='middle' font-family='Segoe UI' font-size='19' font-weight='700' fill='#12346C'>"
			                        & FORMAT(__TotalGeneral, "#,0")
			                    & "</text>"
			                    & "<text x='" & FORMAT(__CX, "0", "en-US") & "' y='" & FORMAT(__CY + 15, "0", "en-US") & "'"
			                        & " text-anchor='middle' font-family='Segoe UI' font-size='8' fill='#62708A'>Total</text>"
			                & "</svg>"
			                & "<div style='flex:1 1 auto;min-width:0;max-height:100%;display:flex;flex-direction:column;justify-content:center;overflow-y:auto;overflow-x:hidden;'>"
			                    & __LeyendaHTML
			                & "</div>"
			            & "</div>"
			        )
			    & "</div>"
		displayFolder: Diseno HTML\Graficos
		lineageTag: c3d4e5f6-0023-4a44-9c44-400000000023

	measure HTML_Vision_Barras_Cliente =
			
			
			VAR __Esp = SELECTEDVALUE(Tabla_Combinada[tipo_caso_especialista])
			VAR __TipoDef = SELECTEDVALUE(Tabla_Combinada[tipo_definitivo])
			VAR __Titulo =
			    IF(
			        NOT ISBLANK(__TipoDef) && __TipoDef <> "",
			        __TipoDef & " por Cliente",
			        IF(
			            NOT ISBLANK(__Esp) && __Esp <> "",
			            __Esp & " por Cliente",
			            "Por Cliente"
			        )
			    )
			
			VAR __BaseCompleta =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES(Tabla_Combinada[contact_company]),
			            "@Total", CALCULATE(DISTINCTCOUNT(Tabla_Combinada[incident_number]))
			        ),
			        [@Total] > 0
			    )
			
			VAR __TotalCategorias = COALESCE(COUNTROWS(__BaseCompleta), 0)
			VAR __Base = TOPN(10, __BaseCompleta, [@Total], DESC)
			VAR __SufijoTop =
			    IF(
			        __TotalCategorias > 10,
			        " - Top 10 de " & FORMAT(__TotalCategorias, "#,0"),
			        ""
			    )
			
			VAR __Cantidad = COUNTROWS(__Base)
			/* Alto cableado, convencion de esta plantilla. El grafico llena la tarjeta:
			   el alto se reparte entre las categorias descontando el row-gap de 5 px.
			   Con 10 categorias cae en el piso de 19 y queda como antes; con pocas,
			   engorda en vez de dejar la mitad de la tarjeta en blanco. */
			VAR __AltoContenedor = 180
			VAR __AltoCuerpo = MAX(60, __AltoContenedor - 36)
			VAR __AltoFila =
			    MIN(
			        46,
			        MAX(
			            19,
			            INT(
			                DIVIDE(
			                    __AltoCuerpo - (MAX(__Cantidad, 1) - 1) * 5,
			                    MAX(__Cantidad, 1),
			                    0
			                )
			            )
			        )
			    )
			VAR __AltoBarra = MAX(10, __AltoFila - 5)
			VAR __ConflictoFiltro =
			    VAR __EspEnScope =
			        COALESCE(COUNTROWS(CALCULATETABLE(
			            VALUES(Tabla_Combinada[tipo_caso_especialista]),
			            REMOVEFILTERS(Calendario)
			        )), 0)
			    VAR __DefEnScope =
			        COALESCE(COUNTROWS(CALCULATETABLE(
			            VALUES(Tabla_Combinada[tipo_definitivo]),
			            REMOVEFILTERS(Calendario)
			        )), 0)
			    RETURN
			        __EspEnScope = 0 || __DefEnScope = 0
			
			VAR __SinDatos = __Cantidad = 0
			VAR __MaxTotal = MAXX(__Base, [@Total])
			
			VAR __FilasHTML =
			    CONCATENATEX(
			        __Base,
			        VAR __Etiqueta =
			            IF(
			                ISBLANK(Tabla_Combinada[contact_company]) || Tabla_Combinada[contact_company] = "",
			                "(Sin cliente)",
			                Tabla_Combinada[contact_company]
			            )
			        VAR __Total = [@Total]
			        VAR __Pct = DIVIDE(__Total, MAX(__MaxTotal, 1), 0) * 100
			        RETURN
			            "<div title='" & __Etiqueta & ": " & FORMAT(__Total, "#,0") & "'"
			                & " style='font-size:10px;color:#3D4D68;white-space:nowrap;"
			                & "text-align:right;'>" & __Etiqueta & "</div>"
			            & "<div style='height:" & FORMAT(__AltoBarra, "0") & "px;display:flex;min-width:0;background:#F1F4FA;"
			                & "border-radius:2px;overflow:hidden;'>"
			                & "<div style='width:" & FORMAT(__Pct, "0.00", "en-US") & "%;height:100%;"
			                & "background:#4A78F6;'></div>"
			            & "</div>"
			            & "<div style='font-size:10px;font-weight:700;color:#12346C;text-align:right;"
			                & "white-space:nowrap;'>" & FORMAT(__Total, "#,0") & "</div>",
			        "",
			        [@Total],
			        DESC
			    )
			
			RETURN
			    "<div style='height:" & FORMAT(__AltoContenedor, "0") & "px;max-height:" & FORMAT(__AltoContenedor, "0") & "px;" & [DS_Contenedor_Estilo] & "'>"
			        & "<div style='font-size:11px;font-weight:700;color:" & [DS_Color_TituloTexto]
			            & ";height:16px;line-height:16px;margin-bottom:1px;flex:0 0 16px;'>" & __Titulo & __SufijoTop & "</div>"
			        & IF(
			            __SinDatos,
			            "<div style='" & [DS_SinDatos_Estilo] & "'>" & IF(__ConflictoFiltro, [DS_SinDatos_Conflicto], [DS_SinDatos_Mensaje]) & "</div>",
			            "<div style='height:" & FORMAT(__AltoCuerpo, "0") & "px;overflow-y:auto;" & "overflow-x:auto;box-sizing:border-box;padding-right:2px;'>"
			                & "<div style='display:grid;grid-template-columns:max-content minmax(40px,1fr) max-content;"
			                & "column-gap:7px;row-gap:5px;align-items:center;width:100%;box-sizing:border-box;" & "height:100%;grid-auto-rows:" & FORMAT(__AltoFila, "0") & "px;align-content:center;'>"
			                & __FilasHTML
			                & "</div>"
			            & "</div>"
			        )
			    & "</div>"
		displayFolder: Diseno HTML\Graficos\Vision
		lineageTag: e5f6a7b8-0002-4c66-9e66-600000000002

	measure HTML_Vision_Combo_Volumetria =
			
			VAR __Meses =
			    FILTER(
			        ADDCOLUMNS(
			            SUMMARIZE(Tabla_Combinada, Calendario[Anio], Calendario[Mes]),
			            "@Orden", Calendario[Anio] * 100 + Calendario[Mes],
			            "@Etiqueta",
			                SWITCH(
			                    Calendario[Mes],
			                    1, "ene", 2, "feb", 3, "mar", 4, "abr", 5, "may", 6, "jun",
			                    7, "jul", 8, "ago", 9, "sep", 10, "oct", 11, "nov", 12, "dic", ""
			                )
			                    & " " & RIGHT(FORMAT(Calendario[Anio], "0000"), 2),
			            "@Total", CALCULATE(DISTINCTCOUNT(Tabla_Combinada[incident_number]))
			        ),
			        [@Total] > 0
			    )
			
			VAR __Cantidad = COUNTROWS(__Meses)
			VAR __Maximo = MAXX(__Meses, [@Total])
			VAR __SinDatos = __Cantidad = 0 || ISBLANK(__Maximo)
			
			VAR __Grupos =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES(tb_dim_fte[grupo_soporte]),
			            "@Color", [DS_Color_Grupo_Oscuro],
			            "@OrdenGrupo", [DS_Orden_Grupo],
			            "@ValorGrupo", CALCULATE(DISTINCTCOUNT(Tabla_Combinada[incident_number]))
			        ),
			        [@ValorGrupo] > 0
			    )
			
			VAR __ColumnasHTML =
			    CONCATENATEX(
			        __Meses,
			        VAR __AnioAct = Calendario[Anio]
			        VAR __MesAct = Calendario[Mes]
			        VAR __TotalAct = [@Total]
			        VAR __EtiqAct = [@Etiqueta]
			        VAR __AlturaBarraPx = MAX(4, DIVIDE(__TotalAct, MAX(__Maximo, 1), 0) * 90)
			        VAR __Segmentos =
			            CONCATENATEX(
			                __Grupos,
			                VAR __GrupoAct = tb_dim_fte[grupo_soporte]
			                VAR __ColorAct = [@Color]
			                VAR __Valor =
			                    CALCULATE(
			                        DISTINCTCOUNT(Tabla_Combinada[incident_number]),
			                        KEEPFILTERS(TREATAS({__AnioAct}, Calendario[Anio])),
			                        KEEPFILTERS(TREATAS({__MesAct}, Calendario[Mes])),
			                        KEEPFILTERS(TREATAS({__GrupoAct}, tb_dim_fte[grupo_soporte]))
			                    )
			                VAR __H = MAX(0, DIVIDE(__Valor, MAX(__TotalAct, 1), 0) * 100)
			                RETURN
			                    IF(
			                        __Valor > 0,
			                        "<div title='" & __EtiqAct & " | " & __GrupoAct & ": " & FORMAT(__Valor, "#,0") & "'"
				                            & " style='width:100%;flex:" & FORMAT(__Valor, "0", "en-US") & " 1 0%;min-height:1px;background:"
			                            & __ColorAct & ";box-sizing:border-box;'></div>",
			                        ""
			                    ),
			                "",
			                [@OrdenGrupo],
			                DESC
			            )
			        RETURN
			            "<div style='display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;min-width:0;box-sizing:border-box;padding:0 3px;'>"
			                & "<div style='font-size:10px;font-weight:700;color:#3D4D68;line-height:13px;'>"
			                & FORMAT(__TotalAct, "#,0") & "</div>"
			                & "<div style='width:66%;max-width:42px;min-width:10px;height:"
			                & FORMAT(__AlturaBarraPx, "0", "en-US") & "px;flex:0 0 " & FORMAT(__AlturaBarraPx, "0", "en-US") & "px;display:flex;flex-direction:column;"
			                & "justify-content:flex-end;overflow:hidden;border-radius:2px 2px 0 0;box-sizing:border-box;'>"
			                & __Segmentos
			                & "</div>"
			                & "<div style='font-size:9px;color:#62708A;line-height:13px;white-space:nowrap;'>"
			                & __EtiqAct & "</div>"
			            & "</div>",
			        "",
			        [@Orden],
			        ASC
			    )
			
			VAR __LeyendaHTML =
			    CONCATENATEX(
			        __Grupos,
			        VAR __G = IF(ISBLANK(tb_dim_fte[grupo_soporte]) || tb_dim_fte[grupo_soporte] = "", "(Sin asignar)", tb_dim_fte[grupo_soporte])
			        RETURN
			            "<span style='display:inline-flex;align-items:center;gap:3px;margin-right:10px;font-size:9px;"
			                & "color:#53627C;white-space:nowrap;'>"
			                & "<span style='width:8px;height:8px;border-radius:2px;background:" & [@Color] & ";display:inline-block;'></span>"
			                & __G & "</span>",
			        "",
			        [@OrdenGrupo],
			        ASC
			    )
			
			RETURN
			    "<div style='height:100%;max-height:100%;" & [DS_Contenedor_Estilo] & "'>"
			        & "<div style='font-size:12px;font-weight:700;color:" & [DS_Color_TituloTexto]
			            & ";height:18px;line-height:18px;flex:0 0 18px;'>Volumetria</div>"
			        & IF(
			            __SinDatos,
			            "<div style='" & [DS_SinDatos_Estilo] & "'>" & [DS_SinDatos_Mensaje] & "</div>",
			            "<div style='flex:1 1 auto;min-height:0;display:flex;flex-direction:column;overflow:hidden;'>"
			                & "<div style='flex:1 1 auto;min-height:0;overflow-x:auto;overflow-y:hidden;'>"
			                    & "<div style='display:grid;grid-template-columns:repeat("
			                    & FORMAT(__Cantidad, "0") & ", minmax(40px,1fr));align-items:end;height:100%;"
			                    & "width:" & IF(__Cantidad <= 22, "100%", FORMAT(__Cantidad * 34, "0") & "px") & ";"
			                    & "box-sizing:border-box;'>"
			                    & __ColumnasHTML
			                    & "</div>"
			                & "</div>"
			                & "<div style='flex:0 0 15px;height:15px;display:flex;align-items:center;overflow:hidden;'>"
			                    & __LeyendaHTML
			                & "</div>"
			            & "</div>"
			        )
			    & "</div>"
		displayFolder: Diseno HTML\Graficos\Vision
		lineageTag: e5f6a7b8-0006-4c66-9e66-600000000006


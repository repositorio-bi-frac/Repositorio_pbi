	/// ================================================================
	/// PALETA DE SERIES CENTRALIZADA
	/// Los motores toman el color n con PATHITEM([DS_Paleta], MOD(orden - 1, 8) + 1).
	/// Cambiar esta sola medida cambia el color de todas las series del informe.
	/// Viene de la migracion de Colombia: reemplaza al SWITCH de 8 colores que
	/// antes se repetia dentro de cada motor.
	/// ================================================================
	measure DS_Paleta = "#0F2D68|#1E4FAF|#4A78F6|#1198A5|#7B93D6|#8FADF9|#5FC2CE|#2F5FC4"
		displayFolder: Diseno HTML\Tokens
		lineageTag: b1a70000-9001-4000-9000-000000000001

	/// ================================================================
	/// MODELO NUEVO 1: GAUGE SEMICIRCULAR
	/// Arco de 180 grados en SVG, misma matematica que la dona pero con un solo
	/// tramo: angulo = PI * (1 - valor), punto final en cx + r*COS(ang) y
	/// cy - r*SIN(ang), con sweep-flag = 1. El viewBox se alinea a los pixeles
	/// reales para que el texto no se comprima.
	/// Para reutilizarlo: cambiar el numerador y el denominador de __V, y el titulo.
	/// ================================================================
	measure HTML_Gauge =
			VAR __Total = DISTINCTCOUNT(Tabla_Combinada[incident_number])
			VAR __Cerrados =
			    CALCULATE(
			        DISTINCTCOUNT(Tabla_Combinada[incident_number]),
			        KEEPFILTERS(TREATAS({ "Cerrado" }, tb_dim_status[status]))
			    )
			VAR __V = MIN(MAX(COALESCE(DIVIDE(__Cerrados, __Total, 0), 0), 0), 1)
			VAR __W = 200
			VAR __H = 118
			VAR __CX = __W * 0.5
			VAR __CY = 96
			VAR __R = 78
			VAR __Grosor = 18
			VAR __Ang = PI() * (1 - __V)
			VAR __X2 = __CX + __R * COS(__Ang)
			VAR __Y2 = __CY - __R * SIN(__Ang)
			VAR __Color = PATHITEM([DS_Paleta], 2)
			VAR __Pista =
			    "<path d='M " & FORMAT(__CX - __R, "0.0", "en-US") & " " & FORMAT(__CY, "0.0", "en-US")
			        & " A " & FORMAT(__R, "0.0", "en-US") & " " & FORMAT(__R, "0.0", "en-US")
			        & " 0 0 1 " & FORMAT(__CX + __R, "0.0", "en-US") & " " & FORMAT(__CY, "0.0", "en-US") & "'"
			        & " fill='none' stroke='#E4E9EF' stroke-width='" & FORMAT(__Grosor, "0") & "' stroke-linecap='round'></path>"
			VAR __Arco =
			    IF(
			        __V <= 0,
			        "",
			        "<path d='M " & FORMAT(__CX - __R, "0.0", "en-US") & " " & FORMAT(__CY, "0.0", "en-US")
			            & " A " & FORMAT(__R, "0.0", "en-US") & " " & FORMAT(__R, "0.0", "en-US")
			            & " 0 0 1 " & FORMAT(__X2, "0.0", "en-US") & " " & FORMAT(__Y2, "0.0", "en-US") & "'"
			            & " fill='none' stroke='" & __Color & "' stroke-width='" & FORMAT(__Grosor, "0") & "' stroke-linecap='round'></path>"
			    )
			RETURN
			    "<div style='height:100%;max-height:100%;" & [DS_Contenedor_Estilo] & "'>"
			        & "<div style='" & [DS_Titulo_Estilo] & "'>Casos cerrados sobre el total</div>"
			        & "<div style='flex:1 1 auto;min-height:0;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;'>"
			            & "<div style='flex:0 0 " & FORMAT(__H, "0") & "px;height:" & FORMAT(__H, "0") & "px;'>"
			                & "<svg xmlns='http://www.w3.org/2000/svg' width='" & FORMAT(__W, "0") & "' height='" & FORMAT(__H, "0") & "'"
			                    & " viewBox='0 0 " & FORMAT(__W, "0") & " " & FORMAT(__H, "0") & "' style='display:block;'>"
			                    & __Pista
			                    & __Arco
			                    & "<text x='" & FORMAT(__CX, "0") & "' y='" & FORMAT(__CY - 22, "0") & "' text-anchor='middle'"
			                        & " font-family='Segoe UI' font-size='30' font-weight='700' fill='" & [DS_Color_TituloTexto] & "'>"
			                        & FORMAT(__V, "0.0%", "en-US")
			                    & "</text>"
			                    & "<text x='" & FORMAT(__CX - __R, "0") & "' y='" & FORMAT(__CY + 13, "0") & "' text-anchor='middle' font-family='Segoe UI' font-size='9' fill='#5B6B8C'>0%</text>"
			                    & "<text x='" & FORMAT(__CX + __R, "0") & "' y='" & FORMAT(__CY + 13, "0") & "' text-anchor='middle' font-family='Segoe UI' font-size='9' fill='#5B6B8C'>100%</text>"
			                & "</svg>"
			            & "</div>"
			            & "<div style='font-size:9px;color:#5B6B8C;padding-top:2px;'>" & FORMAT(__Cerrados, "#,0") & " de " & FORMAT(__Total, "#,0") & " casos</div>"
			        & "</div>"
			    & "</div>"
		displayFolder: Diseno HTML\Graficos
		lineageTag: b1a70000-9001-4000-9000-000000000002

	/// ================================================================
	/// MODELO NUEVO 2: MATRIZ CON MEDIDAS COMO COLUMNAS
	/// Filas = una columna de dimension. Columnas = N medidas.
	/// Es la otra forma posible: los demas motores parten UNA medida por una
	/// dimension; este pone VARIAS medidas una al lado de la otra.
	/// Para reutilizarlo: cambiar la columna del SUMMARIZE y las medidas del ADDCOLUMNS.
	/// ================================================================
	measure HTML_Matriz_Medidas =
			VAR __Filas =
			    FILTER(
			        ADDCOLUMNS(
			            SUMMARIZE(Tabla_Combinada, tb_dim_status[status]),
			            "@Total", CALCULATE(DISTINCTCOUNT(Tabla_Combinada[incident_number])),
			            "@Dias", CALCULATE(AVERAGE(Tabla_Combinada[duracion_resolucion_soc_dias]))
			        ),
			        [@Total] > 0
			    )
			VAR __Cantidad = COALESCE(COUNTROWS(__Filas), 0)
			VAR __TotalGeneral = SUMX(__Filas, [@Total])
			VAR __Encabezado =
			    "<div style='font-size:9px;font-weight:700;color:#FFFFFF;background:" & [DS_Color_TituloTexto] & ";padding:3px 6px;position:sticky;top:0;border-radius:4px 0 0 0;box-sizing:border-box;white-space:nowrap;'>ESTADO</div>"
			    & "<div style='font-size:9px;font-weight:700;color:#FFFFFF;background:" & [DS_Color_TituloTexto] & ";padding:3px 6px;position:sticky;top:0;text-align:right;box-sizing:border-box;'>CASOS</div>"
			    & "<div style='font-size:9px;font-weight:700;color:#FFFFFF;background:" & [DS_Color_TituloTexto] & ";padding:3px 6px;position:sticky;top:0;text-align:right;box-sizing:border-box;'>%</div>"
			    & "<div style='font-size:9px;font-weight:700;color:#FFFFFF;background:" & [DS_Color_TituloTexto] & ";padding:3px 6px;position:sticky;top:0;text-align:right;border-radius:0 4px 0 0;box-sizing:border-box;'>DIAS</div>"
			VAR __Cuerpo =
			    CONCATENATEX(
			        __Filas,
			        VAR __Etq = IF(ISBLANK(tb_dim_status[status]) || tb_dim_status[status] = "", "(Sin dato)", tb_dim_status[status])
			        VAR __T = [@Total]
			        VAR __D = [@Dias]
			        VAR __P = DIVIDE(__T, __TotalGeneral, 0)
			        RETURN
			            "<div title='" & __Etq & "' style='font-size:10px;font-weight:600;color:" & [DS_Color_TituloTexto] & ";padding:3px 6px;white-space:nowrap;border-bottom:1px solid #DCE6F5;box-sizing:border-box;'>" & __Etq & "</div>"
			            & "<div style='font-size:11px;font-weight:700;color:" & [DS_Color_TituloTexto] & ";padding:3px 6px;text-align:right;border-bottom:1px solid #DCE6F5;box-sizing:border-box;'>" & FORMAT(__T, "#,0") & "</div>"
			            & "<div style='font-size:10px;font-weight:600;color:#5B6B8C;padding:3px 6px;text-align:right;border-bottom:1px solid #DCE6F5;box-sizing:border-box;'>" & FORMAT(__P, "0.0%", "en-US") & "</div>"
			            & "<div style='font-size:10px;font-weight:600;color:#5B6B8C;padding:3px 6px;text-align:right;border-bottom:1px solid #DCE6F5;box-sizing:border-box;'>" & FORMAT(__D, "0.0", "en-US") & "</div>",
			        "",
			        [@Total],
			        DESC
			    )
			RETURN
			    "<div style='height:100%;max-height:100%;" & [DS_Contenedor_Estilo] & "'>"
			        & "<div style='" & [DS_Titulo_Estilo] & "'>Estado &nbsp;&middot;&nbsp; " & FORMAT(__TotalGeneral, "#,0") & " casos</div>"
			        & IF(
			            __Cantidad = 0,
			            "<div style='" & [DS_SinDatos_Estilo] & "'>" & [DS_SinDatos_Mensaje] & "</div>",
			            "<div style='flex:1 1 auto;min-height:0;overflow-y:auto;overflow-x:auto;box-sizing:border-box;'>"
			                & "<div style='display:grid;min-width:max-content;grid-template-columns:max-content minmax(48px,1fr) minmax(44px,1fr) minmax(44px,1fr);'>"
			                    & __Encabezado
			                    & __Cuerpo
			                & "</div>"
			            & "</div>"
			        )
			    & "</div>"
		displayFolder: Diseno HTML\Graficos
		lineageTag: b1a70000-9001-4000-9000-000000000003

	/// ================================================================
	/// MODELO NUEVO 3: CHIPS DE REFERENCIA
	/// Lista de valores como pildoras, para contexto que no necesita un grafico.
	/// Nacio de resolver una pagina de tooltip: los visuales HTML no las disparan,
	/// asi que el contenido pasa a mostrarse a la vista.
	/// Para reutilizarlo: cambiar la columna del SUMMARIZE y el titulo.
	/// ================================================================
	measure HTML_Chips =
			VAR __Base =
			    FILTER(
			        ADDCOLUMNS(
			            SUMMARIZE(Tabla_Combinada, Tabla_Combinada[categorization_tier_2]),
			            "@Total", CALCULATE(DISTINCTCOUNT(Tabla_Combinada[incident_number]))
			        ),
			        [@Total] > 0
			    )
			VAR __Cantidad = COALESCE(COUNTROWS(__Base), 0)
			VAR __Chips =
			    CONCATENATEX(
			        __Base,
			        VAR __Etq = IF(ISBLANK(Tabla_Combinada[categorization_tier_2]) || Tabla_Combinada[categorization_tier_2] = "", "(Sin dato)", Tabla_Combinada[categorization_tier_2])
			        RETURN
			            "<span style='display:inline-flex;align-items:center;gap:5px;background:#EAF0FB;border:1px solid "
			            & [DS_Color_Borde]
			            & ";border-radius:10px;padding:1px 9px;margin-right:5px;margin-bottom:3px;font-size:10px;font-weight:600;color:"
			            & [DS_Color_TituloTexto] & ";white-space:nowrap;'>"
			                & __Etq
			                & "<span style='font-weight:400;color:#5B6B8C;'>" & FORMAT([@Total], "#,0") & "</span>"
			            & "</span>",
			        "",
			        [@Total],
			        DESC
			    )
			RETURN
			    "<div style='height:100%;max-height:100%;" & [DS_Contenedor_Estilo] & "'>"
			        & "<div style='font-size:10px;font-weight:700;color:#5B6B8C;flex:0 0 14px;height:14px;line-height:14px;'>CATEGORIAS PRESENTES</div>"
			        & IF(
			            __Cantidad = 0,
			            "<div style='" & [DS_SinDatos_Estilo] & "'>" & [DS_SinDatos_Mensaje] & "</div>",
			            "<div style='flex:1 1 auto;min-height:0;display:flex;align-items:center;flex-wrap:wrap;overflow:hidden;'>" & __Chips & "</div>"
			        )
			    & "</div>"
		displayFolder: Diseno HTML\Graficos
		lineageTag: b1a70000-9001-4000-9000-000000000004

	measure DS_Icono_EnCurso = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' style='flex-shrink:0;'><circle cx='12' cy='12' r='9' stroke='#1E4FAF' stroke-width='1.8'/><path d='M9 8l7 4-7 4V8z' fill='#4A78F6'/></svg>"

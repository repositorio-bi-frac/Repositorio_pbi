		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Date
		isKey
		formatString: General Date
		lineageTag: eb8c6a95-a4c3-4ef8-a37b-e5f0e4a15e36
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				-- Rango derivado de Tabla_Combinada: desde la fecha mas antigua
				-- que exista en el dato hasta hoy. MINX y MAXX ignoran los blancos.
				VAR __MinApertura = MINX(Tabla_Combinada, Tabla_Combinada[fecha_apertura_dia])
				VAR __MinCierre = MINX(Tabla_Combinada, Tabla_Combinada[fecha_cierre_dia])
				VAR __MaxApertura = MAXX(Tabla_Combinada, Tabla_Combinada[fecha_apertura_dia])
				VAR __MaxCierre = MAXX(Tabla_Combinada, Tabla_Combinada[fecha_cierre_dia])
				VAR __Inicio = COALESCE(MINX({ __MinApertura, __MinCierre }, [Value]), TODAY())
				VAR __MaxDato = COALESCE(MAXX({ __MaxApertura, __MaxCierre }, [Value]), TODAY())
				-- si algun caso tuviera fecha futura se extiende el rango, para que
				-- ninguna fila quede fuera del calendario y caiga en la fila en blanco
				VAR __Fin = MAXX({ TODAY(), __MaxDato }, [Value])
				RETURN
				    CALENDAR(__Inicio, __Fin)

	annotation PBI_ResultType = Table

